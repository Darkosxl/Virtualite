source 'https://rubygems.org'

gem 'sinatra'
gem 'sinatra-contrib' # Provides sinatra/json extension
gem 'rackup'      # Rack server for production
gem 'puma'        # Web server
gem 'mail'        # Email sending
gem 'pg'          # PostgreSQL adapter for Supabase
gem 'json'        # JSON parsing
gem 'dotenv'      # Environment variable management
gem 'google_drive' # Google Sheets integration

group :development do
  gem 'rerun'  # Auto-restart server on file changes
end
