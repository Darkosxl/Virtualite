<!-- Simple Success Message -->
<div style="text-align: center; padding: 2rem; max-width: 600px; margin: 2rem auto;">
    
    <h2 style="color: white; font-size: 2rem; font-weight: 700; margin-bottom: 1rem;">Rezervasyon Tamamlandı!</h2>
    
    <p style="color: white; font-size: 1.2rem; margin-bottom: 2rem; opacity: 0.9;">Ekimibiz seninle telefonda iletişime geçecek</p>
    
    <!-- Small colorful tick mark -->
    <div style="margin: 2rem 0;">
        <svg style="width: 3rem; height: 3rem; margin: 0 auto; color: #4ade80;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
        </svg>
    </div>

    <!-- Return to homepage -->
    <button onclick="window.location.href='/'" 
            style="background: linear-gradient(to right, #f87171, #4db5bc); color: white; padding: 0.75rem 2rem; border-radius: 9999px; font-weight: 600; border: none; cursor: pointer; transition: all 0.3s;">
        Ana Sayfaya Dön
    </button>

</div>

<script>
// Hide all previous steps
if (document.getElementById('datetime-selection')) {
    document.getElementById('datetime-selection').style.display = 'none';
}

// Meta Pixel Schedule event tracking
const eventId = (crypto.randomUUID && crypto.randomUUID()) || String(Date.now());
window.bookingEventId = eventId;

// Get Facebook click ID and browser ID from cookies if available
function getCookie(name) {
    const value = "; " + document.cookie;
    const parts = value.split("; " + name + "=");
    if (parts.length === 2) return parts.pop().split(";").shift();
    return null;
}

const fbc = getCookie('_fbc') || (new URLSearchParams(window.location.search).get('fbclid') ? 'fb.1.' + Date.now() + '.' + new URLSearchParams(window.location.search).get('fbclid') : null);
const fbp = getCookie('_fbp');

// Fire the Schedule event to Meta Pixel
fbq('track', 'Schedule', {
    event_id: eventId,
    value: 0.00,
    currency: 'EUR',
    booking_id: '<%= booking_id || "unknown" %>',
    content_name: 'Editing consultation booking'
});

// Send the same event to our server for Conversions API (server-side tracking)
<% if defined?(booking_id) && booking_id %>
fetch('/meta/schedule', {
    method: 'POST',
    headers: {
        'Content-Type': 'application/json',
    },
    body: JSON.stringify({
        event_id: eventId,
        booking_id: '<%= booking_id %>',
        email: '<%= defined?(email) ? email : "" %>',
        phone: '<%= defined?(phone) ? phone : "" %>',
        fbc: fbc,
        fbp: fbp
    })
}).catch(error => {
    console.log('Conversions API tracking failed:', error);
});
<% end %>
</script>