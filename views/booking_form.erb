<!-- Step 2: Contact Information Form - Overlay Style -->
<div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; z-index: 50; padding: 1rem; overflow-y: auto;">
    <div style="max-width: 42rem; width: 100%; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 1.5rem; padding: 2rem; box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25); max-height: calc(100vh - 2rem); overflow-y: auto; background: linear-gradient(135deg, #730202 0%, #F2522E 100%); backdrop-filter: blur(10px); margin: auto;">
    
    <!-- Progress indicator -->
    <div style="display: flex; justify-content: center; margin-bottom: 2rem;">
        <div style="display: flex; align-items: center;">
            <div style="width: 2rem; height: 2rem; background-color: #F2D194; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #262626; font-weight: 600; font-size: 0.875rem;">✓</div>
            <div style="width: 3rem; height: 0.25rem; background-color: #F2D194; margin: 0 0.5rem;"></div>
            <div style="width: 2rem; height: 2rem; background: linear-gradient(to right, #F2522E, #F24535); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 0.875rem;">2</div>
        </div>
    </div>

    <h3 style="color: white; font-size: 1.5rem; font-weight: 700; text-align: center; margin-bottom: 1.5rem;" data-tr="Bilgilerinizi Girin" data-en="Enter Your Information" data-it="Inserisci le Tue Informazioni">Bilgilerinizi Girin</h3>
    
    <p style="color: white; text-align: center; margin-bottom: 1.5rem; opacity: 0.9;">
        <span data-tr="Seçtiğiniz tarih:" data-en="Selected date:" data-it="Data selezionata:">Seçtiğiniz tarih:</span> <strong><%= selected_date %></strong> - <strong><%= selected_time %></strong>
    </p>

    <form id="contact-form" action="/submit-booking" method="post">
        <input type="hidden" name="selected_date" value="<%= selected_date %>">
        <input type="hidden" name="selected_time" value="<%= selected_time %>">
        <input type="hidden" name="load_time" value="<%= params['load_time'] %>">
        <input type="hidden" name="g-recaptcha-response" id="recaptchaResponse">
        
        <!-- Honeypot trap - hidden field only bots will fill -->
        <div style="position: absolute; left: -5000px;" aria-hidden="true">
          <input type="text" name="user_nickname" tabindex="-1" value="">
        </div>

        <!-- Name input -->
        <div style="margin-bottom: 1.5rem;">
            <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" data-tr="Adınız Soyadınız *" data-en="Your Full Name *" data-it="Il Tuo Nome Completo *">Adınız Soyadınız *</label>
            <input type="text"
                   name="name"
                   required
                   style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); color: white; transition: all 0.3s;"
                   data-placeholder-tr="Adınız ve soyadınızı girin"
                   data-placeholder-en="Enter your full name"
                   data-placeholder-it="Inserisci il tuo nome completo"
                   placeholder="Adınız ve soyadınızı girin">
        </div>

        <!-- Phone input -->
        <div style="margin-bottom: 1.5rem;">
            <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" data-tr="Telefon Numaranız *" data-en="Your Phone Number *" data-it="Il Tuo Numero di Telefono *">Telefon Numaranız *</label>
            <input type="tel"
                   name="phone_number"
                   required
                   pattern="[0-9\s\-\+\(\)]*"
                   style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); color: white; transition: all 0.3s;"
                   data-placeholder-tr="+90 555 123 45 67"
                   data-placeholder-en="+1 555 123 4567"
                   data-placeholder-it="+39 555 123 456"
                   placeholder="+90 555 123 45 67">
        </div>

        <!-- Occupation selection -->
        <div style="margin-bottom: 1.5rem;">
            <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.75rem;" data-tr="Ne işle meşgulsünüz?" data-en="Occupation" data-it="Occupazione">Ne işle meşgulsünüz?</label>
            <div style="position: relative;">
                <select name="occupation"
                        id="occupation-select"
                        required
                        style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); color: white; transition: all 0.3s; appearance: none; cursor: pointer;">
                    <option value="" data-tr="Seçiniz..." data-en="Select..." data-it="Seleziona...">Seçiniz...</option>
                    <option value="digital_marketing" data-tr="Digital Marketing" data-en="Digital Marketing" data-it="Digital Marketing">Digital Marketing</option>
                    <option value="clothing_brand" data-tr="Giyim Markası" data-en="Clothing Brand" data-it="Marchio di Abbigliamento">Giyim Markası</option>
                    <option value="startup_founder" data-tr="Startup Kurucusu" data-en="Startup Founder" data-it="Startup Founder">Startup Kurucusu</option>
                    <option value="content_creator" data-tr="İçerik Üreticisi" data-en="Content Creator" data-it="Content Creator">İçerik Üreticisi</option>
                    <option value="psychologist" data-tr="Psikolog" data-en="Psychologist" data-it="Psicologo">Psikolog</option>
                    <option value="custom" data-tr="Siz doldurun" data-en="Specify your occupation" data-it="Specifica la tua occupazione">Siz doldurun</option>
                </select>
                <!-- Dropdown arrow -->
                <div style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); pointer-events: none; color: white;">
                    <svg width="12" height="8" viewBox="0 0 12 8" fill="none">
                        <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </div>

            <!-- Custom occupation input (hidden by default) -->
            <div id="custom-occupation" style="margin-top: 0.75rem; display: none;">
                <input type="text"
                       name="custom_occupation"
                       id="custom-occupation-input"
                       style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); color: white; transition: all 0.3s;"
                       data-placeholder-tr="Mesleğinizi yazın"
                       data-placeholder-en="Enter your occupation"
                       data-placeholder-it="Inserisci la tua occupazione"
                       placeholder="Mesleğinizi yazın">
            </div>
        </div>

        <!-- Social media platforms selection -->
        <div style="margin-bottom: 1.5rem;">
            <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.75rem;" data-tr="Hangi sosyal medya platformlarında içerik üretiyorsun?" data-en="Which social media platforms do you create content on?" data-it="Su quali piattaforme social crei contenuti?">Hangi sosyal medya platformlarında içerik üretiyorsun?</label>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <!-- TikTok -->
                <label style="display: flex; align-items: center; cursor: pointer;">
                    <input type="checkbox" 
                           name="social_platforms[]" 
                           value="tiktok" 
                           class="sr-only social-checkbox"
                           data-platform="tiktok"
                           style="position: absolute; left: -10000px;">
                    <div style="width: 1.25rem; height: 1.25rem; border: 2px solid white; border-radius: 0.25rem; margin-right: 0.75rem; display: flex; align-items: center; justify-content: center;">
                        <div class="checkbox-dot" style="width: 0.5rem; height: 0.5rem; background-color: white; border-radius: 0.125rem; display: none;"></div>
                    </div>
                    <span style="color: white;">TikTok</span>
                </label>
                <div id="tiktok-username" style="margin-left: 2rem; display: none;">
                    <input type="text"
                           name="tiktok_username"
                           style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); color: white;"
                           data-placeholder-tr="TikTok kullanıcı adınız"
                           data-placeholder-en="Your TikTok username"
                           data-placeholder-it="Il tuo nome utente TikTok"
                           placeholder="TikTok kullanıcı adınız">
                </div>

                <!-- Instagram -->
                <label style="display: flex; align-items: center; cursor: pointer;">
                    <input type="checkbox" 
                           name="social_platforms[]" 
                           value="instagram" 
                           class="sr-only social-checkbox"
                           data-platform="instagram"
                           style="position: absolute; left: -10000px;">
                    <div style="width: 1.25rem; height: 1.25rem; border: 2px solid white; border-radius: 0.25rem; margin-right: 0.75rem; display: flex; align-items: center; justify-content: center;">
                        <div class="checkbox-dot" style="width: 0.5rem; height: 0.5rem; background-color: white; border-radius: 0.125rem; display: none;"></div>
                    </div>
                    <span style="color: white;">Instagram</span>
                </label>
                <div id="instagram-username" style="margin-left: 2rem; display: none;">
                    <input type="text"
                           name="instagram_username"
                           style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); color: white;"
                           data-placeholder-tr="Instagram kullanıcı adınız"
                           data-placeholder-en="Your Instagram username"
                           data-placeholder-it="Il tuo nome utente Instagram"
                           placeholder="Instagram kullanıcı adınız">
                </div>

                <!-- YouTube -->
                <label style="display: flex; align-items: center; cursor: pointer;">
                    <input type="checkbox" 
                           name="social_platforms[]" 
                           value="youtube" 
                           class="sr-only social-checkbox"
                           data-platform="youtube"
                           style="position: absolute; left: -10000px;">
                    <div style="width: 1.25rem; height: 1.25rem; border: 2px solid white; border-radius: 0.25rem; margin-right: 0.75rem; display: flex; align-items: center; justify-content: center;">
                        <div class="checkbox-dot" style="width: 0.5rem; height: 0.5rem; background-color: white; border-radius: 0.125rem; display: none;"></div>
                    </div>
                    <span style="color: white;">YouTube</span>
                </label>
                <div id="youtube-username" style="margin-left: 2rem; display: none;">
                    <input type="text"
                           name="youtube_username"
                           style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); color: white;"
                           data-placeholder-tr="YouTube kanal adınız"
                           data-placeholder-en="Your YouTube channel name"
                           data-placeholder-it="Il nome del tuo canale YouTube"
                           placeholder="YouTube kanal adınız">
                </div>
            </div>
        </div>

        <!-- Submit button -->
        <button type="submit" 
                id="submit-booking-btn"
                disabled
                style="width: 100%; background: linear-gradient(to right, #F2522E, #F24535); color: white; padding: 1rem 1.5rem; border-radius: 0.75rem; font-weight: 600; font-size: 1.125rem; transition: all 0.3s; border: none; cursor: pointer; opacity: 0.5;">
            <span class="htmx-indicator" id="loading" style="display: none;">
                <svg style="animation: spin 1s linear infinite; margin-left: -0.25rem; margin-right: 0.75rem; height: 1.25rem; width: 1.25rem; color: white; display: inline;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle style="opacity: 0.25;" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path style="opacity: 0.75;" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </span>
            <span data-tr="Rezervasyonu Tamamla" data-en="Complete Booking" data-it="Completa Prenotazione">Rezervasyonu Tamamla</span>
        </button>
    </form>

    <!-- Back button -->
    <button onclick="document.getElementById('booking-steps').innerHTML = ''" 
            style="width: 100%; margin-top: 1rem; color: white; text-align: center; padding: 0.5rem; opacity: 0.7; transition: opacity 0.3s; background: none; border: none; cursor: pointer;">
        <span data-tr="← Tarih seçimine geri dön" data-en="← Back to date selection" data-it="← Torna alla selezione della data">← Tarih seçimine geri dön</span>
    </button>
    
    </div>
</div>

<style>
/* Custom checkbox styling */
.social-checkbox:checked + div .checkbox-dot {
    display: block !important;
}

.social-checkbox:checked + div {
    border-color: #F24535 !important;
    background-color: rgba(242, 69, 53, 0.1) !important;
}

.htmx-indicator {
    display: none !important;
}

.htmx-request .htmx-indicator {
    display: inline !important;
}

.htmx-request button {
    opacity: 0.7 !important;
    pointer-events: none !important;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* Input focus styles */
input:focus {
    outline: none !important;
    box-shadow: 0 0 0 2px #F24535 !important;
    border-color: transparent !important;
}

/* Placeholder text styling */
input::placeholder {
    color: rgba(255, 255, 255, 0.7) !important;
    opacity: 1 !important;
}

/* Select dropdown styling */
select {
    color: white !important;
}

select option {
    background-color: #730202 !important;
    color: white !important;
}

select:focus {
    outline: none !important;
    box-shadow: 0 0 0 2px #F24535 !important;
    border-color: transparent !important;
}

/* Button hover effects */
#submit-booking-btn:not(:disabled):hover {
    transform: scale(1.05);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}

#submit-booking-btn:not(:disabled) {
    opacity: 1 !important;
    cursor: pointer !important;
}

button:last-child:hover {
    opacity: 1 !important;
}
</style>

<script>
// Handle occupation dropdown selection
document.getElementById('occupation-select').addEventListener('change', function() {
    const customOccupationDiv = document.getElementById('custom-occupation');
    const customOccupationInput = document.getElementById('custom-occupation-input');

    if (this.value === 'custom') {
        customOccupationDiv.style.display = 'block';
        customOccupationInput.required = true;
    } else {
        customOccupationDiv.style.display = 'none';
        customOccupationInput.required = false;
        customOccupationInput.value = '';
    }

    // Check form validation
    validateForm();
});

// Handle custom occupation input changes
document.getElementById('custom-occupation-input').addEventListener('input', validateForm);

// Handle social platform checkbox selection
document.querySelectorAll('.social-checkbox').forEach(checkbox => {
    checkbox.addEventListener('change', function() {
        const platform = this.getAttribute('data-platform');
        const usernameDiv = document.getElementById(`${platform}-username`);

        if (this.checked) {
            usernameDiv.style.display = 'block';
        } else {
            usernameDiv.style.display = 'none';
            // Clear the username input when unchecked
            const usernameInput = usernameDiv.querySelector('input');
            if (usernameInput) usernameInput.value = '';
        }

        // Check form validation
        validateForm();
    });
});

// Handle username input changes
document.querySelectorAll('input[name$="_username"]').forEach(input => {
    input.addEventListener('input', validateForm);
});

// Form validation function
function validateForm() {
    const checkboxes = document.querySelectorAll('.social-checkbox');
    const submitBtn = document.getElementById('submit-booking-btn');
    const occupationSelect = document.getElementById('occupation-select');
    const customOccupationInput = document.getElementById('custom-occupation-input');

    // Check occupation validation
    let hasValidOccupation = false;
    if (occupationSelect.value && occupationSelect.value !== '') {
        if (occupationSelect.value === 'custom') {
            // If custom is selected, check if the custom input has a value
            hasValidOccupation = customOccupationInput.value.trim() !== '';
        } else {
            // Any other selection is valid
            hasValidOccupation = true;
        }
    }

    // Check social media selection validation
    let hasValidSocialSelection = false;
    checkboxes.forEach(checkbox => {
        if (checkbox.checked) {
            const platform = checkbox.getAttribute('data-platform');
            const usernameInput = document.querySelector(`input[name="${platform}_username"]`);
            if (usernameInput && usernameInput.value.trim() !== '') {
                hasValidSocialSelection = true;
            }
        }
    });

    // Both occupation and at least one social platform must be valid
    if (hasValidOccupation && hasValidSocialSelection) {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.style.cursor = 'pointer';
    } else {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
    }
}

// Initial validation check
validateForm();

// Handle form submission with reCAPTCHA
document.getElementById('contact-form').addEventListener('submit', function(e) {
    e.preventDefault();

    // Only execute reCAPTCHA if the form is valid
    const submitBtn = document.getElementById('submit-booking-btn');
    if (submitBtn.disabled) {
        return;
    }

    const form = this;

    // Check if reCAPTCHA is available
    if (typeof grecaptcha !== 'undefined') {
        grecaptcha.ready(function() {
            grecaptcha.execute('6LfyocYrAAAAAAO2wxWMTCTxNWrbS-qVSU_woJjU', {action: 'submit'}).then(function(token) {
                // Add the token to the form
                document.getElementById('recaptchaResponse').value = token;

                // Now submit the form normally
                form.submit();
            });
        });
    } else {
        // If reCAPTCHA is not available, submit anyway (fallback)
        form.submit();
    }
});

// The main page's MutationObserver will automatically handle translations for this form
</script>