<!-- Step 2: Contact Information Form -->
<div class="max-w-2xl mx-auto bg-white bg-opacity-10 backdrop-blur-lg rounded-3xl p-8 mt-6 border border-white border-opacity-20">
    
    <!-- Progress indicator -->
    <div class="flex justify-center mb-8">
        <div class="flex items-center">
            <div class="w-8 h-8 bg-green-400 rounded-full flex items-center justify-center text-white font-semibold text-sm">✓</div>
            <div class="w-12 h-1 bg-green-400 mx-2"></div>
            <div class="w-8 h-8 bg-gradient-to-r from-red-400 to-teal-400 rounded-full flex items-center justify-center text-white font-semibold text-sm">2</div>
        </div>
    </div>

    <h3 class="text-white text-2xl font-bold text-center mb-6">Bilgilerinizi Girin</h3>
    
    <p class="text-white text-center mb-6 opacity-90">
        Seçtiğiniz tarih: <strong><%= selected_date %></strong> - <strong><%= selected_time %></strong>
    </p>

    <form id="contact-form" hx-post="/submit-booking" hx-target="#booking-steps" hx-indicator="#loading">
        <input type="hidden" name="selected_date" value="<%= selected_date %>">
        <input type="hidden" name="selected_time" value="<%= selected_time %>">

        <!-- Name input -->
        <div class="mb-6">
            <label class="block text-white font-semibold mb-2">Adınız Soyadınız *</label>
            <input type="text" 
                   name="name" 
                   required 
                   class="w-full px-4 py-3 rounded-xl bg-white bg-opacity-10 border border-white border-opacity-20 text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent"
                   placeholder="Adınız ve soyadınızı girin">
        </div>

        <!-- Phone input -->
        <div class="mb-6">
            <label class="block text-white font-semibold mb-2">Telefon Numaranız *</label>
            <input type="tel" 
                   name="phone_number" 
                   required 
                   pattern="[0-9\s\-\+\(\)]*"
                   class="w-full px-4 py-3 rounded-xl bg-white bg-opacity-10 border border-white border-opacity-20 text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent"
                   placeholder="+90 555 123 45 67">
        </div>

        <!-- Social media platforms selection -->
        <div class="mb-6">
            <label class="block text-white font-semibold mb-3">Hangi sosyal medya platformlarında içerik üretiyorsun'?'</label>
            <div class="space-y-4">
                <!-- TikTok -->
                <label class="flex items-center cursor-pointer">
                    <input type="checkbox" 
                           name="social_platforms[]" 
                           value="tiktok" 
                           class="sr-only social-checkbox"
                           data-platform="tiktok">
                    <div class="w-5 h-5 border-2 border-white rounded mr-3 flex items-center justify-center">
                        <div class="w-2 h-2 bg-white rounded hidden checkbox-dot"></div>
                    </div>
                    <span class="text-white">TikTok</span>
                </label>
                <div id="tiktok-username" class="ml-8 hidden">
                    <div class="relative">
                        <input type="text" 
                               name="tiktok_username" 
                               class="w-full pl-4 pr-12 py-3 rounded-xl bg-white bg-opacity-10 border border-white border-opacity-20 text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent"
                               placeholder="TikTok kullanıcı adınız">
                        <div class="absolute right-3 top-3 w-6 h-6 rounded flex items-center justify-center">
                            <img src="/pictures/tiktoklogo.jpeg" alt="TikTok" class="w-full h-full object-cover rounded">
                        </div>
                    </div>
                </div>

                <!-- Instagram -->
                <label class="flex items-center cursor-pointer">
                    <input type="checkbox" 
                           name="social_platforms[]" 
                           value="instagram" 
                           class="sr-only social-checkbox"
                           data-platform="instagram">
                    <div class="w-5 h-5 border-2 border-white rounded mr-3 flex items-center justify-center">
                        <div class="w-2 h-2 bg-white rounded hidden checkbox-dot"></div>
                    </div>
                    <span class="text-white">Instagram</span>
                </label>
                <div id="instagram-username" class="ml-8 hidden">
                    <div class="relative">
                        <input type="text" 
                               name="instagram_username" 
                               class="w-full pl-4 pr-12 py-3 rounded-xl bg-white bg-opacity-10 border border-white border-opacity-20 text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent"
                               placeholder="Instagram kullanıcı adınız">
                        <div class="absolute right-3 top-3 w-6 h-6 rounded flex items-center justify-center">
                            <img src="/pictures/instagramlogo.jpg" alt="Instagram" class="w-full h-full object-cover rounded">
                        </div>
                    </div>
                </div>

                <!-- YouTube -->
                <label class="flex items-center cursor-pointer">
                    <input type="checkbox" 
                           name="social_platforms[]" 
                           value="youtube" 
                           class="sr-only social-checkbox"
                           data-platform="youtube">
                    <div class="w-5 h-5 border-2 border-white rounded mr-3 flex items-center justify-center">
                        <div class="w-2 h-2 bg-white rounded hidden checkbox-dot"></div>
                    </div>
                    <span class="text-white">YouTube</span>
                </label>
                <div id="youtube-username" class="ml-8 hidden">
                    <div class="relative">
                        <input type="text" 
                               name="youtube_username" 
                               class="w-full pl-4 pr-12 py-3 rounded-xl bg-white bg-opacity-10 border border-white border-opacity-20 text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent"
                               placeholder="YouTube kanal adınız">
                        <div class="absolute right-3 top-3 w-6 h-6 rounded flex items-center justify-center">
                            <img src="/pictures/ytlogo.png" alt="YouTube" class="w-full h-full object-cover rounded">
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Submit button -->
        <button type="submit" 
                class="w-full bg-gradient-to-r from-red-400 to-teal-400 text-white py-4 px-6 rounded-xl font-semibold text-lg transition-all duration-300 hover:scale-105 hover:shadow-xl disabled:opacity-50">
            <span class="htmx-indicator" id="loading">
                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </span>
            Rezervasyonu Tamamla
        </button>
    </form>

    <!-- Back button -->
    <button onclick="document.getElementById('datetime-selection').style.display='block'; document.getElementById('booking-steps').innerHTML=''" 
            class="w-full mt-4 text-white text-center py-2 opacity-70 hover:opacity-100 transition-opacity">
        ← Tarih seçimine geri dön
    </button>

</div>


<style>
/* Custom checkbox styling */
.social-checkbox:checked + div .checkbox-dot {
    display: block !important;
}

.social-checkbox:checked + div {
    border-color: #4ecdc4;
    background-color: rgba(78, 205, 196, 0.1);
}

.htmx-indicator {
    display: none;
}

.htmx-request .htmx-indicator {
    display: inline;
}

.htmx-request button {
    opacity: 0.7;
    pointer-events: none;
}
</style>

<script>
// Hide the datetime selection when form loads
document.getElementById('datetime-selection').style.display = 'none';

// Handle social platform checkbox selection
document.querySelectorAll('.social-checkbox').forEach(checkbox => {
    checkbox.addEventListener('change', function() {
        const platform = this.getAttribute('data-platform');
        const usernameDiv = document.getElementById(`${platform}-username`);
        
        if (this.checked) {
            usernameDiv.classList.remove('hidden');
        } else {
            usernameDiv.classList.add('hidden');
            // Clear the username input when unchecked
            const usernameInput = usernameDiv.querySelector('input');
            if (usernameInput) usernameInput.value = '';
        }
    });
});
</script>
