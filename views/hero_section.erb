            <a href="#services" class="nav-link" data-tr="Portfolyo" data-en="Portfolio" data-it="Portfolio">Portfolyo</a>
            <a href="#contact" class="nav-link" data-tr="Bize Ulaş" data-en="Contact Us" data-it="Contattaci">Bize Ulaş</a>
            <div class="language-dropdown">
                <div class="language-select" id="languageSelect">
                    <div class="selected-language" id="selectedLanguage">
