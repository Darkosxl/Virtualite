<style>
/* Navbar styles */
.navbar {
    position: fixed;
    top: 1vh;
    left: 50%;
    transform: translateX(-50%) scale(0.94);
    z-index: 1000;
    background: linear-gradient(135deg, #730202 0%, #F2522E 100%);
    backdrop-filter: blur(10px);
    border: 0.0625vw solid rgba(255, 255, 255, 0.2);
    border-radius: 3.125vw;
    padding: 0.8vh 1.5vw;
    box-shadow: 0 0.625vw 1.875vw rgba(115, 2, 2, 0.3);
    width: auto;
    max-width: 90%;
}

.nav-container {
    display: flex;
    justify-content: center;
    gap: 2vw;
    align-items: center;
}

.nav-logo {
    height: 3.125vw;
    min-height: 35px;
    max-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    cursor: none;
}

.nav-logo:hover {
    transform: translateY(-0.125vw);
}

.nav-logo img {
    height: 100%;
    width: auto;
    object-fit: contain;
}

.nav-link {
    color: white;
    text-decoration: none;
    font-weight: 600;
    font-size: clamp(0.8rem, 1vw, 1.2rem);
    padding: 0.6vh 1.5vw;
    border-radius: 1.56vw;
    background: rgba(255, 255, 255, 0.15);
    border: 0.0625vw solid rgba(255, 255, 255, 0.25);
    transition: all 0.3s ease;
    cursor: none;
    backdrop-filter: blur(5px);
    white-space: nowrap;
}

.nav-link:hover {
    background: linear-gradient(45deg, #F2522E, #F24535);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-0.125vw);
    box-shadow: 0 0.5vw 1.25vw rgba(242, 69, 53, 0.3);
}

.nav-link:last-child {
    color: white;
    font-weight: 999;
}

/* Language dropdown */
.language-dropdown {
    position: relative;
    display: inline-block;
}

.language-select {
    position: relative;
    display: inline-block;
}

.selected-language {
    background: rgba(255, 255, 255, 0.15);
    border: 0.0625vw solid rgba(255, 255, 255, 0.25);
    border-radius: 1.56vw;
    color: white;
    padding: 0.6vh 1.5vw;
    font-size: clamp(0.8rem, 1vw, 1.2rem);
    font-weight: 600;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI Emoji', 'Noto Color Emoji', 'Apple Color Emoji', sans-serif;
    cursor: pointer;
    backdrop-filter: blur(5px);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
    white-space: nowrap;
    min-width: auto;
}

.selected-language:hover {
    background: linear-gradient(45deg, #F2522E, #F24535);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-0.125vw);
    box-shadow: 0 0.5vw 1.25vw rgba(242, 69, 53, 0.3);
}

.flag-icon {
    width: 24px;
    height: 18px;
    border-radius: 3px;
    object-fit: cover;
}

.language-options {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(38, 38, 38, 0.95);
    border: 0.0625vw solid rgba(255, 255, 255, 0.25);
    border-radius: 1.56vw;
    backdrop-filter: blur(10px);
    margin-top: 0.5vh;
    display: none;
    z-index: 1000;
}

.language-options.show {
    display: block;
}

.language-option {
    padding: 0.6vh 1.5vw;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(0.8rem, 1vw, 1.2rem);
    font-weight: 600;
    transition: background 0.3s ease;
}

.language-option:hover {
    background: rgba(242, 82, 46, 0.3);
}

.language-option:first-child {
    border-radius: 1.56vw 1.56vw 0 0;
}

.language-option:last-child {
    border-radius: 0 0 1.56vw 1.56vw;
}

/* Hero section with static gradient - performance optimized */
.hero {
    height: 100vh;
    min-height: -webkit-fill-available;
    height: 100dvh;
    background: linear-gradient(135deg, #F2D194 0%, #730202 50%, #262626 100%);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding-top: 5vh;
}

.hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(1px);
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 42%;
    padding: 3vh 2vw;
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
}

.hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-grow: 1;
    justify-content: center;
}

.hero h1 {
    font-size: clamp(2.34rem, 5.2vw, 5.2rem);
    font-weight: 900;
    margin-bottom: 3vh;
    background: linear-gradient(45deg, #fff, #F2522E, #F24535);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
    letter-spacing: -0.02em;
}

.hero p {
    font-size: clamp(0.91rem, 1.3vw, 1.56rem);
    margin-bottom: 2vh;
    opacity: 0.95;
    font-weight: 300;
    line-height: 1.6;
}

.cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.2vh 3.5vw;
    background: linear-gradient(45deg, #F2522E, #F24535);
    color: white;
    text-decoration: none;
    border-radius: 3.125vw;
    font-weight: 600;
    font-size: clamp(1rem, 1.2vw, 1.4rem);
    transition: all 0.3s ease;
    border: none;
    cursor: none;
    position: relative;
    overflow: hidden;
    margin: 2vh 0;
    text-align: center;
}

.cta-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s;
}

.cta-button:hover::before {
    left: 100%;
}

.cta-button:hover {
    transform: translateY(-0.31vw);
    box-shadow: 0 1.25vw 2.5vw rgba(242, 82, 46, 0.3);
}

.scroll-indicator {
    position: absolute;
    bottom: 6vh;
    bottom: max(6vh, env(safe-area-inset-bottom, 6vh));
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    padding: 0.8vh 1.5vw;
    border-radius: 1.875vw;
    font-size: clamp(0.8rem, 0.9vw, 1rem);
    border: 0.0625vw solid rgba(255, 255, 255, 0.2);
    animation: bounce 2s infinite;
}

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
    40% { transform: translateX(-50%) translateY(-0.625vw); }
    60% { transform: translateX(-50%) translateY(-0.3125vw); }
}

/* WebGL Shader Canvas - constrained to hero section */
#shader-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
}

/* Responsive navbar */
@media (max-width: 1024px) {
    .nav-container {
        gap: 1.5vw;
    }
}

@media (max-width: 768px) {
    .navbar {
        transform: translateX(-50%) scale(0.85);
        padding: 0.6vh 1.2vw;
    }

    .nav-link {
        font-size: 0.75rem;
        padding: 0.5vh 1.2vw;
    }

    .hero-content {
        max-width: 90%;
    }

    .hero h1 {
        font-size: 2rem;
    }

    .hero p {
        font-size: 0.9rem;
    }
}
</style>

<nav class="navbar">
        <div class="nav-container">
