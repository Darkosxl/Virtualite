<style>
/* Navbar styles */
.navbar {
    position: fixed;
    top: 1vh;
    left: 50%;
    transform: translateX(-50%) scale(0.94);
    z-index: 1000;
    background: linear-gradient(135deg, #730202 0%, #F2522E 100%);
    backdrop-filter: blur(10px);
    border: 0.0625vw solid rgba(255, 255, 255, 0.2);
    border-radius: 3.125vw;
    padding: 0.8vh 1.5vw;
    box-shadow: 0 0.625vw 1.875vw rgba(115, 2, 2, 0.3);
    width: auto;
    max-width: 90%;
}

.nav-container {
    display: flex;
    justify-content: center;
    gap: 2vw;
    align-items: center;
}

.nav-logo {
    height: 3.125vw;
    min-height: 35px;
    max-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    cursor: none;
}

.nav-logo:hover {
    transform: translateY(-0.125vw);
}

.nav-logo img {
    height: 100%;
    width: auto;
    object-fit: contain;
}

.nav-link {
    color: white;
    text-decoration: none;
    font-weight: 600;
    font-size: clamp(0.8rem, 1vw, 1.2rem);
    padding: 0.6vh 1.5vw;
    border-radius: 1.56vw;
    background: rgba(255, 255, 255, 0.15);
    border: 0.0625vw solid rgba(255, 255, 255, 0.25);
    transition: all 0.3s ease;
    cursor: none;
    backdrop-filter: blur(5px);
    white-space: nowrap;
}

.nav-link:hover {
    background: linear-gradient(45deg, #F2522E, #F24535);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-0.125vw);
    box-shadow: 0 0.5vw 1.25vw rgba(242, 69, 53, 0.3);
}

.nav-link:last-child {
    color: white;
    font-weight: 999;
}

/* Language dropdown */
.language-dropdown {
    position: relative;
    display: inline-block;
}

.language-select {
    position: relative;
    display: inline-block;
}

.selected-language {
    background: rgba(17, 17, 17, 0.6);
    border: none;
    border-radius: 12px;
    color: white;
    padding: 0.6vh 1.5vw;
    font-size: clamp(0.8rem, 1vw, 1.2rem);
    font-weight: 600;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI Emoji', 'Noto Color Emoji', 'Apple Color Emoji', sans-serif;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    position: relative;
    flex-shrink: 0;
    white-space: nowrap;
    min-width: auto;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
}

.selected-language:hover {
    background: rgba(17, 17, 17, 0.82);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
}

.flag-icon {
    width: 24px;
    height: 18px;
    border-radius: 3px;
    object-fit: cover;
}

/* Chevron icon */
.chevron-icon {
    width: 16px;
    height: 16px;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-block;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
}

.selected-language.open .chevron-icon {
    transform: rotate(180deg);
}

.language-options {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: rgba(17, 17, 17, 0.6);
    border: none;
    border-radius: 12px;
    backdrop-filter: blur(10px);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
    z-index: 1000;
    padding: 4px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    opacity: 0;
    transform: translateY(-5px) scale(0.95);
    filter: blur(10px);
    pointer-events: none;
    transition: all 0.6s cubic-bezier(0.3, 0, 0, 1);
}

.language-options.show {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0px);
    pointer-events: auto;
}

.language-option {
    padding: 12px 8px;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(0.8rem, 1vw, 1.2rem);
    font-weight: 600;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 8px;
    opacity: 0;
    transform: translateX(10px) scale(0.95);
    filter: blur(10px);
}

.language-options.show .language-option {
    opacity: 1;
    transform: translateX(0) scale(1);
    filter: blur(0px);
}

/* Staggered animation delays */
.language-options.show .language-option:nth-child(1) {
    transition-delay: 0s;
}

.language-options.show .language-option:nth-child(2) {
    transition-delay: 0.1s;
}

.language-options.show .language-option:nth-child(3) {
    transition-delay: 0.2s;
}

.language-option:hover {
    background: rgba(17, 17, 17, 0.25);
    transform: translateX(0) scale(0.95);
}

.language-option:active {
    transform: translateX(0) scale(0.9);
}

.language-option:first-child {
    border-radius: 8px;
}

.language-option:last-child {
    border-radius: 8px;
}

/* Hero section with static gradient - performance optimized */
.hero {
    height: 100vh;
    min-height: -webkit-fill-available;
    height: 100dvh;
    background: transparent;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding-top: 5vh;
}

.hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: transparent;
    backdrop-filter: none;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 42%;
    padding: 3vh 2vw;
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
}

.hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-grow: 1;
    justify-content: center;
}

.hero h1 {
    font-size: clamp(2.34rem, 5.2vw, 5.2rem);
    font-weight: 900;
    margin-bottom: 3vh;
    color: white;
    line-height: 1.1;
    letter-spacing: -0.02em;
}

.hero h1 .gradient-text {
    background: linear-gradient(45deg, #F2522E, #F24535, #fff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero p a {
    color: #F2522E;
    text-decoration: none;
    transition: color 0.3s ease;
}

.hero p a:hover {
    color: #F24535;
}

.hero p {
    font-size: clamp(0.91rem, 1.3vw, 1.56rem);
    margin-bottom: 2vh;
    opacity: 0.95;
    font-weight: 300;
    line-height: 1.6;
}

.cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.2vh 3.5vw;
    background: linear-gradient(45deg, #F2522E, #F24535);
    color: white;
    text-decoration: none;
    border-radius: 3.125vw;
    font-weight: 600;
    font-size: clamp(1rem, 1.2vw, 1.4rem);
    transition: all 0.3s ease;
    border: none;
    cursor: none;
    position: relative;
    overflow: hidden;
    margin: 2vh 0;
    text-align: center;
}

.cta-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s;
}

.cta-button:hover::before {
    left: 100%;
}

.cta-button:hover {
    transform: translateY(-0.31vw);
    box-shadow: 0 1.25vw 2.5vw rgba(242, 82, 46, 0.3);
}

/* WebGL Shader Canvas - now in index.html with fixed positioning */

/* Responsive navbar */
@media (max-width: 1024px) {
    .nav-container {
        gap: 1.5vw;
    }
}

@media (max-width: 768px) {
    .navbar {
        transform: translateX(-50%) scale(1);
        padding: 0.8vh 1.5vw;
        max-width: 96%;
        width: 96%;
    }

    .nav-container {
        gap: 1vw;
    }

    .nav-link {
        font-size: 0.8rem;
        padding: 0.8vh 2vw;
        white-space: nowrap;
    }

    .nav-logo {
        min-height: 35px;
        max-height: 35px;
    }

    .selected-language {
        padding: 0.8vh 1.5vw;
        font-size: 0.8rem;
        min-width: auto;
    }

    .flag-icon {
        width: 20px;
        height: 15px;
    }

    .chevron-icon {
        width: 14px;
        height: 14px;
    }

    .hero-content {
        max-width: 90%;
    }

    .hero h1 {
        font-size: 2rem;
    }

    .hero p {
        font-size: 0.9rem;
    }
}
</style>

