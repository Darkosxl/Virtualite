                        <div class="language-option" data-lang="en">
                            <img src="pictures/us.svg" class="flag-icon" alt="US">
                        </div>
                        <div class="language-option" data-lang="it">
                            <img src="pictures/it.svg" class="flag-icon" alt="IT">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

