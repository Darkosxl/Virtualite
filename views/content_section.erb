<style>
/* Content showcase section - transparent to show shader animation */
.content-showcase {
    padding: 3vh 2vw 5vh 2vw;
    background: transparent;
    position: relative;
    z-index: 1;
    border-radius: 3vh 3vh 0 0;
    margin-top: -3vh;
    margin-bottom: 0;
}

/* Stats styles within content showcase */
.stats-title {
    font-size: clamp(2rem, 2.5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1vh;
    color: white;
    text-align: center;
}

.stats-subtitle {
