    font-weight: 800;
    color: white;
    margin-bottom: 0.5vh;
}

.video-creator-tag {
    font-size: clamp(1rem, 1.2vw, 1.4rem);
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 2vh;
}

.video-description {
    font-size: clamp(1.1rem, 1.3vw, 1.5rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
}

/* Carousel Controls */
.carousel-controls {
    display: flex;
    gap: 1.5vw;
}

.carousel-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: white;
}

.carousel-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
}

.carousel-btn svg {
    transition: transform 0.3s ease;
}

.carousel-prev:hover svg {
    transform: rotate(12deg);
}

.carousel-next:hover svg {
    transform: rotate(-12deg);
}

/* Responsive design */
@media (max-width: 1200px) {
    .content-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 3vw;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 900px) {
    .content-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 3vw;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .stat-item {
        padding: 2vh 2vw;
        border-radius: 3vw;
        min-height: 12vh;
    }

    .stat-number {
        font-size: clamp(1.2rem, 4vw, 1.8rem);
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.1;
    }

    .stat-label {
        font-size: clamp(0.9rem, 3vw, 1.2rem);
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.2;
    }

    /* Switch to mobile layout */
    .desktop-only {
        display: none !important;
    }

    .mobile-only {
        display: flex !important;
        flex-direction: column;
    }

    .long-video-container {
        max-width: 95%;
    }

    /* Reduce grid gaps on smaller tablets */
    .short-videos-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 4vw;
    }
}

@media (max-width: 480px) {
    .short-videos-grid {
        grid-template-columns: 1fr;
        gap: 2vh;
    }

    .video-carousel-container {
        grid-template-columns: 1fr;
        gap: 4vh;
    }

    .video-cards-section {
        height: 400px;
    }

    .carousel-btn {
        width: 40px;
        height: 40px;
    }
}
</style>

