    aspect-ratio: 9/16;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    object-fit: cover;
}

/* Mobile: Vertical stack */
.short-videos-stack {
    display: flex;
    flex-direction: column;
    gap: 2vh;
    max-width: 90%;
    margin: 0 auto;
}

.short-videos-stack .short-video {
    width: 100%;
    height: clamp(300px, 60vh, 500px);
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    object-fit: cover;
}

.long-video-container {
    display: flex;
    justify-content: center;
    margin: 0 auto;
    max-width: 90%;
}

.long-video {
    width: 100%;
    max-width: 900px;
    height: auto;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.video-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, #F2522E, #F24535);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(2rem, 3vw, 4rem);
    color: white;
}

/* Simple video-lite system */
.video-lite {
    position: relative;
    width: 100%;
    height: 100%;
    border: none;
    padding: 0;
    background: transparent;
    cursor: pointer;
    border-radius: inherit;
    overflow: hidden;
}

.video-lite img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
}

.video-lite::after {
    content: '▶';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.7);
    color: white;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    transition: all 0.3s ease;
}

.video-lite:hover::after {
    background: rgba(255, 255, 255, 0.9);
    color: black;
    transform: translate(-50%, -50%) scale(1.1);
}

/* Custom video controls styling */
video {
    position: relative;
}

/* Hide fullscreen and menu buttons - more comprehensive */
video::-webkit-media-controls-fullscreen-button,
video::-webkit-media-controls-overflow-button,
video::-webkit-media-controls-overflow-menu-button {
    display: none !important;
}

/* For Firefox */
video::-moz-media-controls,
video::-moz-media-controls-fullscreen-button {
    display: none !important;
}

/* Style mute button and add tooltip */
video::-webkit-media-controls-mute-button {
    opacity: 0.7;
    cursor: not-allowed !important;
    pointer-events: none;
}

/* Simple tooltip for muted videos */
video[title]:hover::after {
    content: attr(title);
    position: absolute;
    bottom: 50px;
    right: 20px;
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 12px;
    white-space: nowrap;
    z-index: 1000;
    pointer-events: none;
}

.content-info {
    padding: 1.5vh 1vw;
}

.content-brand {
    font-size: clamp(1rem, 1.1vw, 1.3rem);
    font-weight: 600;
    color: #666;
    margin-bottom: 0.5vh;
}

.content-title {
    font-size: clamp(1.1rem, 1.3vw, 1.5rem);
    font-weight: 700;
    color: #333;
    margin-bottom: 1vh;
}

.content-stats {
    display: flex;
    gap: 1vw;
    font-size: clamp(0.8rem, 0.9vw, 1rem);
    color: #888;
}

/* 3D Cylindrical Video Carousel Styles */
.video-carousel-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 6vh auto;
    padding: 0 4vw;
    min-height: 500px;
}

.carousel-3d-container {
    width: 100%;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1500px;
    perspective-origin: 50% 50%;
    position: relative;
    overflow: visible;
    background: transparent;
}

.carousel-3d-cylinder {
    position: relative;
    width: 100%;
    max-width: 1800px;
    height: 100%;
    transform-style: preserve-3d;
    cursor: grab;
    transition: transform 0.1s ease-out;
    will-change: transform;
    transform: rotateY(0deg);
}

.carousel-3d-cylinder:active {
    cursor: grabbing;
}

.carousel-3d-face {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border-radius: 20px;
    overflow: visible;
    padding: 8px;
    transform-style: preserve-3d;
    backface-visibility: visible;
    transform-origin: center center;
}

.carousel-3d-face button {
    width: 100%;
    height: 100%;
    border: none;
    padding: 0;
    background: #000;
    cursor: pointer;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
}

.carousel-3d-face button:hover {
    transform: scale(1.08);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
}

.carousel-3d-face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    pointer-events: none;
    display: block;
}

/* Play button overlay */
.carousel-3d-face button::after {
    content: '▶';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.7);
    color: white;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    transition: all 0.3s ease;
    pointer-events: none;
}

.carousel-3d-face button:hover::after {
    background: rgba(255, 255, 255, 0.9);
    color: black;
    transform: translate(-50%, -50%) scale(1.1);
}

/* Video Modal/Overlay */
.video-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.95);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease;
    padding: 20px;
}

.video-modal-overlay.active {
    display: flex;
    opacity: 1;
}

.video-modal-content {
    position: relative;
    max-width: 95vw;
    max-height: 95vh;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: videoModalZoom 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
}

@keyframes videoModalZoom {
    0% {
        transform: scale(0.5);
        opacity: 0;
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}

.video-modal-content video {
    max-width: 100%;
    max-height: 95vh;
    border-radius: 15px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8);
}

/* Different aspect ratios for videos */
.video-modal-content.aspect-9-16 video {
    width: auto;
    height: 95vh;
    max-width: calc(95vh * 9 / 16);
}

.video-modal-content.aspect-16-9 video {
    width: 90vw;
    max-width: 900px;
    height: auto;
}

.video-modal-content.aspect-1-1 video {
    width: auto;
    height: 80vh;
    max-width: 80vh;
}

.video-modal-close {
    position: absolute;
    top: -50px;
    right: 0;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    font-size: 30px;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.video-modal-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg);
}

/* Responsive design */
@media (max-width: 1200px) {
    .content-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 3vw;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 900px) {
    .content-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 3vw;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .stat-item {
        padding: 2vh 2vw;
        border-radius: 3vw;
        min-height: 12vh;
    }

    .stat-number {
        font-size: clamp(1.2rem, 4vw, 1.8rem);
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.1;
    }

    .stat-label {
        font-size: clamp(0.9rem, 3vw, 1.2rem);
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.2;
    }

    /* Switch to mobile layout */
    .desktop-only {
        display: none !important;
    }

    .mobile-only {
        display: flex !important;
        flex-direction: column;
    }

    .long-video-container {
        max-width: 95%;
    }

    /* Reduce grid gaps on smaller tablets */
    .short-videos-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 4vw;
    }
}

@media (max-width: 480px) {
    .short-videos-grid {
        grid-template-columns: 1fr;
        gap: 2vh;
    }

    .carousel-3d-container {
        height: 400px;
    }

    .video-modal-content.aspect-9-16 video {
        height: 85vh;
        max-width: calc(85vh * 9 / 16);
    }

    .video-modal-close {
        top: -40px;
        width: 40px;
        height: 40px;
        font-size: 24px;
    }
}
</style>

<section class="content-showcase" id="services">
        <div class="container">
            <h2 class="stats-title" data-tr="Sayılarla Amoredit!" data-en="Amoredit by the numbers!" data-it="Amoredit in numeri!">Sayılarla Amoredit!</h2>
            <p class="stats-subtitle" data-tr="Aşk ve edit bir araya gelirse ne mi olur?" data-en="What happens when love and editing come together?" data-it="Cosa succede quando amore e editing si uniscono?">Aşk ve edit bir araya gelirse ne mi olur?</p>
            
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-number">200+</div>
                    <div class="stat-label" data-tr="Video" data-en="Videos" data-it="Video">Video</div>
                </div>
                
                <div class="stat-item">
                    <div class="stat-number" data-tr="15 Milyon" data-en="15 Million" data-it="15 Milioni">15 Milyon</div>
                    <div class="stat-label" data-tr="izlenme" data-en="views" data-it="visualizzazioni">izlenme</div>
                </div>
                
                <div class="stat-item">
                    <div class="stat-number">20+</div>
                    <div class="stat-label" data-tr="İçerik üretici" data-en="Content creators" data-it="Content creator">İçerik üretici</div>
                </div>
                
                <div class="stat-item">
                    <div class="stat-number" data-tr="5 Milyon TL" data-en="100,000+ USD" data-it="100.000+ EUR">5 Milyon TL</div>
                    <div class="stat-label" data-tr="kazandırıldı" data-en="earned" data-it="guadagnati">kazandırıldı</div>
                </div>
            </div>

            <!-- 3D Video Carousel -->
            <div class="video-carousel-wrapper">
                <div class="carousel-3d-container">
                    <div class="carousel-3d-cylinder" id="carousel-3d">
                        <!-- Carousel faces will be generated by JavaScript -->
                    </div>
                </div>
            </div>

            <!-- Video Modal -->
            <div class="video-modal-overlay" id="videoModal">
                <div class="video-modal-content" id="videoModalContent">
                    <button class="video-modal-close" id="videoModalClose" aria-label="Close video">×</button>
                    <video id="modalVideo" controls autoplay></video>
                </div>
            </div>

            <script>
                // 3D Carousel Video Data
                const carouselVideos = [
                    {
                        id: 'umut',
                        name: 'Umut',
                        thumbnail: '/pictures/umutthumbnail.png',
                        videoSrc: '/videos/umut.mov',
                        aspectRatio: '9-16',
                        width: 250,
                        height: 444
                    },
                    {
                        id: 'baran',
                        name: 'Baran',
                        thumbnail: '/pictures/baranthumbnail.png',
                        videoSrc: '/videos/baran.mov',
                        aspectRatio: '9-16',
                        width: 250,
                        height: 444
                    },
                    {
                        id: 'gulizar',
                        name: 'Gülizar',
                        thumbnail: '/pictures/gulizarthumbnail.png',
                        videoSrc: '/videos/gulizar.mov',
                        aspectRatio: '9-16',
                        width: 250,
                        height: 444
                    },
                    {
                        id: 'ceyda',
                        name: 'Ceyda',
                        thumbnail: '/pictures/ceydathumbnail.png',
                        videoSrc: '/videos/ceyda.mov',
                        aspectRatio: '16-9',
                        width: 350,
                        height: 197
                    }
                ];

                // Initialize 3D Carousel
                const cylinder = document.getElementById('carousel-3d');
                const modal = document.getElementById('videoModal');
                const modalContent = document.getElementById('videoModalContent');
                const modalVideo = document.getElementById('modalVideo');
                const closeBtn = document.getElementById('videoModalClose');

                if (!cylinder) {
                    console.error('❌ Carousel cylinder element not found');
                } else {
                    console.log('✅ Carousel cylinder element found:', cylinder);

                    const isMobile = window.innerWidth < 640;
                    const cylinderWidth = isMobile ? 1200 : 2000;
                    const faceCount = carouselVideos.length;
                    const faceWidth = cylinderWidth / faceCount;
                    const radius = cylinderWidth / (2 * Math.PI);
                    
                    console.log('🎡 Carousel Setup:', {
                        cylinderWidth,
                        radius,
                        faceCount,
                        faceWidth,
                        isMobile,
                        videoCount: carouselVideos.length
                    });

                    let rotation = 0;
                    let isDragging = false;
                    let startX = 0;
                    let currentX = 0;
                    let velocity = 0;
                    let animationId = null;

                    // Generate carousel faces
                    carouselVideos.forEach((video, index) => {
                        const face = document.createElement('div');
                        face.className = 'carousel-3d-face';
                        face.style.width = `${video.width}px`;
                        face.style.height = `${video.height}px`;
                        
                        const angle = (index * 360) / faceCount;
                        face.style.transform = `
                            translate(-50%, -50%)
                            rotateY(${angle}deg)
                            translateZ(${radius}px)
                        `;

                        console.log(`🎴 Creating carousel face ${index + 1}/${faceCount}:`, {
                            name: video.name,
                            angle: angle,
                            width: video.width,
                            height: video.height,
                            transform: face.style.transform
                        });

                        const button = document.createElement('button');
                        button.setAttribute('aria-label', `Play ${video.name} video`);
                        button.dataset.videoSrc = video.videoSrc;
                        button.dataset.aspectRatio = video.aspectRatio;

                        const img = document.createElement('img');
                        img.src = video.thumbnail;
                        img.alt = `${video.name} video thumbnail`;
                        img.loading = 'lazy';

                        button.appendChild(img);
                        face.appendChild(button);
                        cylinder.appendChild(face);

                        // Click to play video in modal
                        button.addEventListener('click', (e) => {
                            e.stopPropagation();
                            openVideoModal(video.videoSrc, video.aspectRatio);
                        });
                    });

                    console.log(`✅ Created ${faceCount} carousel faces successfully`);

                    // Apply initial rotation
                    function updateRotation() {
                        cylinder.style.transform = `rotateY(${rotation}deg)`;
                    }

                    // Drag handlers
                    function onDragStart(e) {
                        isDragging = true;
                        startX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
                        currentX = startX;
                        velocity = 0;
                        cylinder.style.transition = 'none';
                        
                        if (animationId) {
                            cancelAnimationFrame(animationId);
                            animationId = null;
                        }
                    }

                    function onDrag(e) {
                        if (!isDragging) return;
                        
                        e.preventDefault();
                        const x = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
                        const deltaX = x - currentX;
                        
                        rotation += deltaX * 0.3;
                        velocity = deltaX * 0.3;
                        currentX = x;
                        
                        updateRotation();
                    }

                    function onDragEnd() {
                        if (!isDragging) return;
                        
                        isDragging = false;
                        cylinder.style.transition = 'transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
                        
                        // Apply momentum
                        if (Math.abs(velocity) > 0.5) {
                            rotation += velocity * 15;
                            updateRotation();
                        }
                    }

                    // Event listeners for drag
                    cylinder.addEventListener('mousedown', onDragStart);
                    cylinder.addEventListener('mousemove', onDrag);
                    cylinder.addEventListener('mouseup', onDragEnd);
                    cylinder.addEventListener('mouseleave', onDragEnd);

                    // Touch events
                    cylinder.addEventListener('touchstart', onDragStart, { passive: false });
                    cylinder.addEventListener('touchmove', onDrag, { passive: false });
                    cylinder.addEventListener('touchend', onDragEnd);

                    // Video modal functions
                    function openVideoModal(videoSrc, aspectRatio) {
                        modalVideo.src = videoSrc;
                        modalContent.className = 'video-modal-content aspect-' + aspectRatio;
                        modal.classList.add('active');
                        document.body.style.overflow = 'hidden';
                        
                        modalVideo.play().catch(e => {
                            console.log('Video autoplay prevented:', e);
                        });
                    }

                    function closeVideoModal() {
                        modal.classList.remove('active');
                        modalVideo.pause();
                        modalVideo.src = '';
                        document.body.style.overflow = '';
                    }

                    // Close modal handlers
                    closeBtn.addEventListener('click', closeVideoModal);
                    modal.addEventListener('click', (e) => {
                        if (e.target === modal) {
                            closeVideoModal();
                        }
                    });

                    // Close on Escape key
                    document.addEventListener('keydown', (e) => {
                        if (e.key === 'Escape' && modal.classList.contains('active')) {
                            closeVideoModal();
                        }
                    });

                    // Initialize rotation
                    updateRotation();
                }
            </script>
        </div>
    </section>