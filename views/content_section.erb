    background: rgba(0, 0, 0, 0.7);
    position: relative;
    z-index: 1;
    border-radius: 3vh 3vh 0 0;
    margin-top: -3vh;
    margin-bottom: 0;
}

/* Stats styles within content showcase */
.stats-title {
    font-size: clamp(2rem, 2.5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1vh;
    color: white;
    text-align: center;
}

.stats-subtitle {
    font-size: clamp(1rem, 1.2vw, 1.4rem);
    margin-bottom: 3vh;
    opacity: 0.9;
    color: white;
