<style>
/* Content showcase section - transparent to show shader animation */
.content-showcase {
    padding: 3vh 2vw 5vh 2vw;
    background: transparent;
    position: relative;
    z-index: 1;
    border-radius: 3vh 3vh 0 0;
    margin-top: -3vh;
    margin-bottom: 0;
}

/* Stats styles within content showcase */
.stats-title {
    font-size: clamp(2rem, 2.5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1vh;
    color: white;
    text-align: center;
}

.stats-subtitle {
    font-size: clamp(1rem, 1.2vw, 1.4rem);
    margin-bottom: 4vh;
    opacity: 0.9;
    color: white;
    font-style: italic;
    text-align: center;
}

/* Bento Grid Styles */
.bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: clamp(0.75rem, 1.5vw, 1rem);
    max-width: 75%;
    height: auto;
    aspect-ratio: 16/9;
    margin: 0 auto 6vh auto;
}

.bento-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    border-radius: clamp(0.75rem, 1.5vw, 1rem);
    padding: clamp(1rem, 2.5vw, 1.5rem);
    background: linear-gradient(135deg, #F2522E, #F24535);
    box-shadow: 0 4px 12px rgba(242, 69, 53, 0.3), 0 8px 24px rgba(0, 0, 0, 0.15);
    transition: all 0.2s ease;
    cursor: pointer;
    text-decoration: none;
}

.bento-card:hover {
    transform: scale(0.98);
    box-shadow: 0 2px 8px rgba(242, 69, 53, 0.2), 0 4px 16px rgba(0, 0, 0, 0.1);
}

.bento-card:active {
    transform: scale(0.95);
}

/* Grid Layout Classes - Explicit positioning */
.bento-card-large {
    grid-column: 1 / 2;
    grid-row: 1 / 4;
}

.bento-card-medium {
    grid-column: 2 / 3;
    grid-row: 1 / 3;
}

.bento-card-small {
    grid-column: 3 / 4;
    grid-row: 1 / 2;
}

.bento-card-medium-alt {
    grid-column: 2 / 3;
    grid-row: 3 / 4;
}

.bento-card-medium-end {
    grid-column: 3 / 4;
    grid-row: 3 / 4;
}

/* Bento Card Content */
.bento-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.bento-icon {
    width: clamp(2rem, 4vw, 2.5rem);
    height: clamp(2rem, 4vw, 2.5rem);
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: clamp(0.25rem, 1vw, 0.5rem);
}

.bento-icon svg {
    width: 100%;
    height: 100%;
}

.bento-title {
    font-size: clamp(1.5rem, 2vw, 2.5rem);
    font-weight: 700;
    color: white;
    margin: 0;
    line-height: 1.2;
}

.bento-description {
    font-size: clamp(0.85rem, 0.95vw, 1rem);
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    max-width: 95%;
}


/* Title Card Styling */
.bento-card-title {
    background: linear-gradient(135deg, rgba(242, 82, 46, 0.95), rgba(242, 69, 53, 0.95));
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.bento-card-title .bento-title {
    font-size: clamp(1.75rem, 2.5vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
}

.bento-card-title .bento-description {
    font-style: italic;
    opacity: 0.95;
}

.container {
    max-width: 90%;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.section-title {
    text-align: center;
    font-size: clamp(2.5rem, 3.5vw, 4rem);
    font-weight: 800;
    margin-bottom: 1vh;
    color: white;
}

.section-subtitle {
    text-align: center;
    font-size: clamp(1.2rem, 1.4vw, 1.6rem);
    margin-bottom: 4vh;
    opacity: 0.9;
    font-weight: 300;
}

.content-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2vw;
}

.content-card {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 1.25vw;
    overflow: hidden;
    box-shadow: 0 1.25vw 2.5vw rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    color: #333;
}

.content-card:hover {
    transform: translateY(-0.9375vw);
    box-shadow: 0 1.875vw 3.75vw rgba(0, 0, 0, 0.2);
}

.content-video {
    width: 100%;
    aspect-ratio: 9/16;
    background: #000;
    position: relative;
    overflow: hidden;
}

/* Video showcase sections */
.short-videos-section {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3vw;
    width: 100%;
}

.long-video-section {
    margin: 4vh 0;
    display: flex;
    justify-content: center;
}

/* Desktop/Mobile visibility toggles */
.mobile-only {
    display: none !important;
}

.desktop-only {
    display: block !important;
}

/* Desktop: Grid layout for short videos */
.short-videos-grid {
    display: flex;
    gap: 2%;
    width: 100%;
    max-width: 1400px;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
}

.short-videos-grid .short-video {
    flex: 1;
    max-width: 32%;
    width: 100%;
    aspect-ratio: 9/16;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    object-fit: cover;
}

/* Mobile: Vertical stack */
.short-videos-stack {
    display: flex;
    flex-direction: column;
    gap: 2vh;
    max-width: 90%;
    margin: 0 auto;
}

.short-videos-stack .short-video {
    width: 100%;
    height: clamp(300px, 60vh, 500px);
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    object-fit: cover;
}

.long-video-container {
    display: flex;
    justify-content: center;
    margin: 0 auto;
    max-width: 90%;
}

.long-video {
    width: 100%;
    max-width: 900px;
    height: auto;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.video-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, #F2522E, #F24535);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(2rem, 3vw, 4rem);
    color: white;
}

/* Simple video-lite system */
.video-lite {
    position: relative;
    width: 100%;
    height: 100%;
    border: none;
    padding: 0;
    background: transparent;
    cursor: pointer;
    border-radius: inherit;
    overflow: hidden;
}

.video-lite img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
}

.video-lite::after {
    content: '▶';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.7);
    color: white;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    transition: all 0.3s ease;
}

.video-lite:hover::after {
    background: rgba(255, 255, 255, 0.9);
    color: black;
    transform: translate(-50%, -50%) scale(1.1);
}

/* Custom video controls styling */
video {
    position: relative;
}

/* Hide fullscreen and menu buttons - more comprehensive */
video::-webkit-media-controls-fullscreen-button,
video::-webkit-media-controls-overflow-button,
video::-webkit-media-controls-overflow-menu-button {
    display: none !important;
}

/* For Firefox */
video::-moz-media-controls,
video::-moz-media-controls-fullscreen-button {
    display: none !important;
}

/* Style mute button and add tooltip */
video::-webkit-media-controls-mute-button {
    opacity: 0.7;
    cursor: not-allowed !important;
    pointer-events: none;
}

/* Simple tooltip for muted videos */
video[title]:hover::after {
    content: attr(title);
    position: absolute;
    bottom: 50px;
    right: 20px;
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 12px;
    white-space: nowrap;
    z-index: 1000;
    pointer-events: none;
}

.content-info {
    padding: 1.5vh 1vw;
}

.content-brand {
    font-size: clamp(1rem, 1.1vw, 1.3rem);
    font-weight: 600;
    color: #666;
    margin-bottom: 0.5vh;
}

.content-title {
    font-size: clamp(1.1rem, 1.3vw, 1.5rem);
    font-weight: 700;
    color: #333;
    margin-bottom: 1vh;
}

.content-stats {
    display: flex;
    gap: 1vw;
    font-size: clamp(0.8rem, 0.9vw, 1rem);
    color: #888;
}


/* Hide and disable volume controls on all videos */
video::-webkit-media-controls-volume-slider,
video::-webkit-media-controls-mute-button {
    display: none !important;
}

video::-moz-volume-slider,
video::-moz-mute-button {
    display: none !important;
}

/* Video Modal/Overlay */
.video-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.95);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease;
    padding: 20px;
}

.video-modal-overlay.active {
    display: flex;
    opacity: 1;
}

.video-modal-content {
    position: relative;
    max-width: 95vw;
    max-height: 95vh;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: videoModalZoom 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
}

@keyframes videoModalZoom {
    0% {
        transform: scale(0.5);
        opacity: 0;
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}

.video-modal-content video {
    max-width: 100%;
    max-height: 95vh;
    border-radius: 15px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8);
}

/* Different aspect ratios for videos */
.video-modal-content.aspect-9-16 video {
    width: auto;
    height: 95vh;
    max-width: calc(95vh * 9 / 16);
}

.video-modal-content.aspect-16-9 video {
    width: 90vw;
    max-width: 900px;
    height: auto;
}

.video-modal-content.aspect-1-1 video {
    width: auto;
    height: 80vh;
    max-width: 80vh;
}

.video-modal-close {
    position: absolute;
    top: -50px;
    right: 0;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    font-size: 30px;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.video-modal-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg);
}

/* Love Ornament Divider - Fully Responsive */
.diagonal-connectors {
    width: 40vw;
    height: auto;
    max-width: 500px;
    min-width: 200px;
    margin: 3vh auto;
    display: block;
    position: relative;
    z-index: 5;
}

@media (max-width: 1200px) {
    .diagonal-connectors {
        width: 50vw;
        max-width: 450px;
    }
}

@media (max-width: 768px) {
    .diagonal-connectors {
        width: 60vw;
        max-width: 400px;
        min-width: 180px;
        margin: 2vh auto;
    }
}

@media (max-width: 480px) {
    .diagonal-connectors {
        width: 70vw;
        max-width: 300px;
        min-width: 150px;
    }
}

/* Gallery Rectangle Container */
.gallery-rectangle-container {
    width: 75%;
    max-width: 75%;
    margin: 0 auto 6vh auto;
    background: linear-gradient(135deg, #F2522E, #F24535);
    border-radius: clamp(0.75rem, 1.5vw, 1rem);
    padding: clamp(2rem, 3vw, 3rem);
    box-shadow: 0 4px 12px rgba(242, 69, 53, 0.3), 0 8px 24px rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    z-index: 5;
}

.gallery-rectangle-inner {
    width: 100%;
}

/* Gallery Header */
.gallery-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2rem;
    gap: 2rem;
}

.gallery-text {
    flex: 1;
}

.gallery-title {
    font-size: clamp(1.875rem, 2.5vw, 3rem);
    font-weight: 500;
    color: white;
    margin: 0 0 1rem 0;
    line-height: 1.2;
}

.gallery-description {
    font-size: clamp(0.875rem, 1vw, 1rem);
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    max-width: 32rem;
    line-height: 1.5;
}

.gallery-nav-buttons {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
}

.gallery-nav-btn {
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border-radius: 0.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
}

.gallery-nav-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
}

.gallery-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

.gallery-nav-btn svg {
    width: 1.25rem;
    height: 1.25rem;
}

/* Gallery Carousel */
.gallery-carousel-container {
    width: 100%;
    overflow: hidden;
    margin-bottom: 2rem;
}

/* Mobile: native scroll with snap points for better UX */
@media (max-width: 768px) {
    .gallery-carousel-container {
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding: 0 10%;
    }
    
    .gallery-carousel-container::-webkit-scrollbar {
        display: none;
    }
}

.gallery-carousel-track {
    display: flex;
    gap: 1.25rem;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    padding: 0 0.5rem;
}

.gallery-carousel-item {
    flex: 0 0 auto;
    width: clamp(320px, 22vw, 360px);
    border-radius: 0.75rem;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease;
    background: transparent;
    border: none;
    padding: 0;
}

.gallery-carousel-item:hover {
    transform: translateY(-0.25rem);
}

.gallery-item-content {
    position: relative;
    width: 100%;
    height: clamp(400px, 27rem, 500px);
    overflow: hidden;
    border-radius: 0.75rem;
    background: rgba(0, 0, 0, 0.2);
}

.gallery-item-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
    display: block;
    cursor: pointer;
}

.gallery-item-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 0.75rem;
}

.gallery-carousel-item.playing .gallery-item-image {
    opacity: 0;
    pointer-events: none;
}

.gallery-carousel-item.playing .gallery-item-video {
    display: block;
}

/* Play button overlay */
.gallery-item-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.gallery-carousel-item:hover .gallery-item-play-overlay {
    opacity: 1;
}

.gallery-carousel-item.playing .gallery-item-play-overlay {
    opacity: 0;
}

.gallery-play-icon {
    width: 60px;
    height: 60px;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
    transition: transform 0.3s ease;
}

.gallery-carousel-item:hover .gallery-play-icon {
    transform: scale(1.1);
}

/* Gallery Dots */
.gallery-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
}

.gallery-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
}

.gallery-dot.active {
    background: white;
    width: 1.5rem;
    border-radius: 0.25rem;
}

/* Responsive design */
    @media (max-width: 1200px) {
    .content-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 3vw;
    }

    .bento-grid {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(3, 1fr);
        height: 60vh;
        min-height: 450px;
        max-height: 550px;
        gap: 1rem;
        max-width: 85%;
    }

    .video-carousel-wrapper {
        max-width: 85%; /* Match bento grid tablet width */
    }

    .diagonal-connectors {
        width: 85%;
        max-width: 85%;
    }

    .gallery-rectangle-container {
        width: 85%;
        max-width: 85%;
        padding: 2rem;
    }

    .gallery-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
    }

    .gallery-nav-buttons {
        align-self: flex-end;
    }

    .bento-card-large {
        grid-column: 1 / 2;
        grid-row: 1 / 3;
    }
    
    .bento-card-medium {
        grid-column: 2 / 3;
        grid-row: 1 / 2;
    }
    
    .bento-card-small {
        grid-column: 1 / 2;
        grid-row: 3 / 4;
    }
    
    .bento-card-medium-alt {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
    }
    
    .bento-card-medium-end {
        grid-column: 2 / 3;
        grid-row: 3 / 4;
    }
    
    .bento-card-title .bento-title {
        font-size: clamp(1.5rem, 4vw, 2rem);
    }
}

@media (max-width: 900px) {
    .content-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 3vw;
    }

    .bento-grid {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(3, 1fr);
        height: 60vh;
        min-height: 450px;
        max-height: 550px;
        max-width: 85%;
    }
}

@media (max-width: 768px) {
    /* Mobile: 2-column bento grid to maintain visual appeal */
    .bento-grid {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(3, minmax(140px, 1fr));
        height: auto;
        min-height: 450px;
        max-height: none;
        gap: clamp(0.5rem, 1.5vw, 0.75rem);
        max-width: 95%;
    }

    .video-carousel-wrapper {
        max-width: 95%; /* Match bento grid mobile width */
    }

    .diagonal-connectors {
        width: 95%;
        max-width: 95%;
        height: 40px;
        margin: -20px auto 0 auto;
    }

    .gallery-rectangle-container {
        width: 95%;
        max-width: 95%;
        padding: 1.5rem;
    }

    .gallery-header {
        margin-bottom: 1.5rem;
    }

    .gallery-nav-buttons {
        display: none;
    }

    /* Mobile: percentage-based card width for better responsiveness */
    .gallery-carousel-item {
        flex: 0 0 80%;
        width: 80%;
        max-width: 320px;
        scroll-snap-align: center;
        scroll-snap-stop: always;
    }

    .gallery-item-content {
        height: auto;
        aspect-ratio: 9/16;
        min-height: 280px;
        max-height: 400px;
    }

    .gallery-rectangle-container {
        padding: 1rem;
    }

    .gallery-carousel-track {
        gap: 1rem;
        padding: 0 0.25rem;
    }

    .gallery-modal-close {
        top: -40px;
        width: 40px;
        height: 40px;
        font-size: 24px;
    }

    .gallery-modal-content.aspect-9-16 video {
        height: 85vh;
        max-width: calc(85vh * 9 / 16);
    }

    /* Mobile bento grid layout - optimized 3-row structure */
    /* Title card spans left column, takes 2 rows */
    .bento-card-large {
        grid-column: 1 / 2;
        grid-row: 1 / 3;
    }

    /* Video card - top right */
    .bento-card-medium {
        grid-column: 2 / 3;
        grid-row: 1 / 2;
    }

    /* 15M views card - middle right */
    .bento-card-small {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
    }

    /* 20+ creators card - bottom left */
    .bento-card-medium-alt {
        grid-column: 1 / 2;
        grid-row: 3 / 4;
    }

    /* 5M TL card - bottom right */
    .bento-card-medium-end {
        grid-column: 2 / 3;
        grid-row: 3 / 4;
    }


    .bento-card-title .bento-title {
        font-size: clamp(1.35rem, 5vw, 1.75rem);
    }

    /* Adjust card padding for mobile */
    .bento-card {
        padding: clamp(0.875rem, 2vw, 1.25rem);
    }

    /* Switch to mobile layout */
    .desktop-only {
        display: none !important;
    }

    .mobile-only {
        display: flex !important;
        flex-direction: column;
    }

    .long-video-container {
        max-width: 95%;
    }

    /* Reduce grid gaps on smaller tablets */
    .short-videos-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 4vw;
    }
}

    @media (max-width: 480px) {
    .short-videos-grid {
        grid-template-columns: 1fr;
        gap: 2vh;
    }

    .carousel-stage-card {
        padding: 1.25rem;
        min-height: 240px;
    }

    .carousel-stage-interior {
        padding: 0.75rem;
    }

    .carousel-3d-container {
        height: 200px;
    }

    .video-modal-content.aspect-9-16 video {
        height: 85vh;
        max-width: calc(85vh * 9 / 16);
    }

