    color: white;
    font-style: italic;
    text-align: center;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5vw;
    max-width: 85%;
    margin: 0 auto 5vh auto;
}

.stat-item {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 0.9375vw;
    padding: 1.5vh 0.8vw;
    border: 0.0625vw solid rgba(255, 255, 255, 0.2);
    transition: transform 0.3s ease;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
}

.stat-item:hover {
    transform: translateY(-0.31vw);
}

.stat-number {
    font-size: clamp(1.5rem, 1.8vw, 2.2rem);
    font-weight: 900;
    color: white;
    margin-bottom: 0.5vh;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.stat-label {
    font-size: clamp(0.8rem, 0.9vw, 1.1rem);
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.container {
    max-width: 90%;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.section-title {
    text-align: center;
    font-size: clamp(2.5rem, 3.5vw, 4rem);
    font-weight: 800;
    margin-bottom: 1vh;
    color: white;
}

.section-subtitle {
    text-align: center;
    font-size: clamp(1.2rem, 1.4vw, 1.6rem);
    margin-bottom: 4vh;
    opacity: 0.9;
    font-weight: 300;
}

.content-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2vw;
}

.content-card {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 1.25vw;
    overflow: hidden;
    box-shadow: 0 1.25vw 2.5vw rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    color: #333;
}

.content-card:hover {
    transform: translateY(-0.9375vw);
    box-shadow: 0 1.875vw 3.75vw rgba(0, 0, 0, 0.2);
}

.content-video {
    width: 100%;
    aspect-ratio: 9/16;
    background: #000;
    position: relative;
    overflow: hidden;
}

/* Video showcase sections */
.short-videos-section {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3vw;
    width: 100%;
}

.long-video-section {
    margin: 4vh 0;
    display: flex;
    justify-content: center;
}

/* Desktop/Mobile visibility toggles */
.mobile-only {
    display: none !important;
}

.desktop-only {
    display: block !important;
}

/* Desktop: Grid layout for short videos */
.short-videos-grid {
    display: flex;
    gap: 2%;
    width: 100%;
    max-width: 1400px;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
}

.short-videos-grid .short-video {
    flex: 1;
