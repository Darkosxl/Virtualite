<!-- Step 3: SMS Verification -->
<div class="max-w-lg mx-auto bg-white bg-opacity-10 backdrop-blur-lg rounded-3xl p-8 mt-6 border border-white border-opacity-20">
    
    <!-- Progress indicator -->
    <div class="flex justify-center mb-8">
        <div class="flex items-center">
            <div class="w-8 h-8 bg-green-400 rounded-full flex items-center justify-center text-white font-semibold text-sm">✓</div>
            <div class="w-12 h-1 bg-green-400 mx-2"></div>
            <div class="w-8 h-8 bg-green-400 rounded-full flex items-center justify-center text-white font-semibold text-sm">✓</div>
            <div class="w-12 h-1 bg-green-400 mx-2"></div>
            <div class="w-8 h-8 bg-gradient-to-r from-red-400 to-teal-400 rounded-full flex items-center justify-center text-white font-semibold text-sm">3</div>
        </div>
    </div>

    <div class="text-center mb-8">
        <div class="w-20 h-20 bg-gradient-to-r from-red-400 to-teal-400 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
        </div>
        
        <h3 class="text-white text-2xl font-bold mb-3">Telefon Doğrulaması</h3>
        <p class="text-white opacity-90 mb-2">6 haneli doğrulama kodu gönderildi:</p>
        <p class="text-teal-300 font-semibold text-lg"><%= phone_number %></p>
    </div>

    <form hx-post="/submit-booking" hx-target="#final-result" hx-indicator="#verify-loading">
        
        <div class="mb-6">
            <label class="block text-white font-semibold mb-3 text-center">Doğrulama Kodunu Girin</label>
            <div class="flex justify-center space-x-2 mb-4">
                <!-- 6 digit input fields -->
                <input type="text" 
                       name="digit1" 
                       maxlength="1" 
                       class="w-12 h-12 text-center text-xl font-bold bg-white bg-opacity-10 border-2 border-white border-opacity-20 rounded-xl text-white focus:outline-none focus:border-teal-400 focus:bg-opacity-20"
                       oninput="moveToNext(this, 'digit2')" 
                       onkeydown="moveToPrev(event, this, null)"
                       pattern="[0-9]">
                <input type="text" 
                       name="digit2" 
                       maxlength="1" 
                       class="w-12 h-12 text-center text-xl font-bold bg-white bg-opacity-10 border-2 border-white border-opacity-20 rounded-xl text-white focus:outline-none focus:border-teal-400 focus:bg-opacity-20"
                       oninput="moveToNext(this, 'digit3')" 
                       onkeydown="moveToPrev(event, this, 'digit1')"
                       pattern="[0-9]">
                <input type="text" 
                       name="digit3" 
                       maxlength="1" 
                       class="w-12 h-12 text-center text-xl font-bold bg-white bg-opacity-10 border-2 border-white border-opacity-20 rounded-xl text-white focus:outline-none focus:border-teal-400 focus:bg-opacity-20"
                       oninput="moveToNext(this, 'digit4')" 
                       onkeydown="moveToPrev(event, this, 'digit2')"
                       pattern="[0-9]">
                <input type="text" 
                       name="digit4" 
                       maxlength="1" 
                       class="w-12 h-12 text-center text-xl font-bold bg-white bg-opacity-10 border-2 border-white border-opacity-20 rounded-xl text-white focus:outline-none focus:border-teal-400 focus:bg-opacity-20"
                       oninput="moveToNext(this, 'digit5')" 
                       onkeydown="moveToPrev(event, this, 'digit3')"
                       pattern="[0-9]">
                <input type="text" 
                       name="digit5" 
                       maxlength="1" 
                       class="w-12 h-12 text-center text-xl font-bold bg-white bg-opacity-10 border-2 border-white border-opacity-20 rounded-xl text-white focus:outline-none focus:border-teal-400 focus:bg-opacity-20"
                       oninput="moveToNext(this, 'digit6')" 
                       onkeydown="moveToPrev(event, this, 'digit4')"
                       pattern="[0-9]">
                <input type="text" 
                       name="digit6" 
                       maxlength="1" 
                       class="w-12 h-12 text-center text-xl font-bold bg-white bg-opacity-10 border-2 border-white border-opacity-20 rounded-xl text-white focus:outline-none focus:border-teal-400 focus:bg-opacity-20"
                       oninput="checkCode()" 
                       onkeydown="moveToPrev(event, this, 'digit5')"
                       pattern="[0-9]">
            </div>
            
            <!-- Hidden input for the complete verification code -->
            <input type="hidden" name="verification_code" id="verification_code">
        </div>

        <button type="submit" 
                id="verify-submit"
                disabled
                class="w-full bg-gradient-to-r from-red-400 to-teal-400 text-white py-4 px-6 rounded-xl font-semibold text-lg transition-all duration-300 hover:scale-105 hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed">
            <span class="htmx-indicator" id="verify-loading">
                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </span>
            Rezervasyonu Tamamla
        </button>
    </form>

    <!-- Resend code option -->
    <div class="text-center mt-6">
        <p class="text-gray-300 text-sm mb-3">Kod gelmedi mi?</p>
        <button class="text-teal-300 hover:text-teal-200 font-semibold transition-colors"
                onclick="resendCode()">
            Tekrar Gönder
        </button>
    </div>

</div>

<!-- Final result area -->
<div id="final-result"></div>

<script>
// Handle digit input navigation
function moveToNext(current, nextId) {
    if (current.value.length === 1 && nextId) {
        document.getElementsByName(nextId)[0].focus();
    }
    checkCode();
}

function moveToPrev(event, current, prevId) {
    if (event.key === 'Backspace' && current.value === '' && prevId) {
        document.getElementsByName(prevId)[0].focus();
    }
}

function checkCode() {
    const digits = ['digit1', 'digit2', 'digit3', 'digit4', 'digit5', 'digit6'];
    const code = digits.map(name => document.getElementsByName(name)[0].value).join('');
    
    document.getElementById('verification_code').value = code;
    
    const submitBtn = document.getElementById('verify-submit');
    if (code.length === 6) {
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    } else {
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
    }
}

function resendCode() {
    // You could implement resend functionality here
    alert('Yeni kod gönderiliyor...');
}

// Focus first input on load
document.getElementsByName('digit1')[0].focus();
</script>
