<style>
body {
    margin: 0;
    padding: 0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #F2D194;
}

.giveaway-page {
    min-height: 100vh;
    background: #F2D194;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    opacity: 1;
    position: relative;
}

.giveaway-page::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg,
        rgba(38, 38, 38, 1) 0%,
        rgba(242, 209, 148, 1) 10%,
        rgba(242, 209, 148, 1) 90%,
        rgba(38, 38, 38, 1) 100%);
    z-index: 0;
    pointer-events: none;
}

@keyframes fadeInContent {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.giveaway-container {
    max-width: 900px;
    width: 100%;
    background: white;
    border-radius: 2rem;
    padding: 3rem;
    box-shadow: 0 20px 60px rgba(115, 2, 2, 0.15);
    position: relative;
    z-index: 1;
}

.giveaway-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 900;
    color: #730202;
    text-align: center;
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
}

/* Override form styles for giveaway section - make text black */
.giveaway-page .form-field label {
    color: #262626 !important;
}

.giveaway-page .form-field input,
.giveaway-page .form-field select,
.giveaway-page .platform-username {
    color: #262626 !important;
    background: rgba(242, 209, 148, 0.2) !important;
    border: 1px solid rgba(115, 2, 2, 0.2) !important;
}

.giveaway-page .form-field input::placeholder,
.giveaway-page .platform-username::placeholder {
    color: rgba(38, 38, 38, 0.5) !important;
}

.giveaway-page .form-field input:focus,
.giveaway-page .form-field select:focus,
.giveaway-page .platform-username:focus {
    background: rgba(242, 209, 148, 0.3) !important;
    border-color: #730202 !important;
    box-shadow: 0 0 0 3px rgba(115, 2, 2, 0.15), 0 4px 12px rgba(115, 2, 2, 0.2) !important;
}

.giveaway-page .social-checkbox:checked + div {
    border-color: #730202 !important;
    background: linear-gradient(135deg, rgba(115, 2, 2, 0.2), rgba(242, 82, 46, 0.15)) !important;
}

.giveaway-page p {
    color: rgba(38, 38, 38, 0.8) !important;
}

.giveaway-page span {
    color: rgba(38, 38, 38, 0.9) !important;
}

.giveaway-subtitle {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 700;
    color: #F2522E;
    text-align: center;
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
}

.giveaway-content {
    color: #262626;
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
}

.giveaway-cta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    position: relative;
    z-index: 1;
}

.giveaway-button {
    background: linear-gradient(135deg, #F2522E, #730202);
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 2rem;
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
}

.giveaway-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(242, 82, 46, 0.4);
}

.giveaway-button.secondary {
    background: transparent;
    color: #730202;
    border: 2px solid #730202;
}

.giveaway-button.secondary:hover {
    background: #730202;
    color: white;
}

@media (max-width: 768px) {
    .giveaway-container {
        padding: 2rem;
    }

    .giveaway-cta {
        flex-direction: column;
    }

    .giveaway-button {
        width: 100%;
    }
}
</style>

<div class="giveaway-page">
    <div class="giveaway-container">
        <h1 class="giveaway-title" data-en="Sign up for 10,000 AED Value Grand Offer" data-it="Iscriviti per l'offerta da 10.000 AED">Sign up for 10,000 AED Value Grand Offer</h1>

        <div class="giveaway-form-container" id="giveaway-form-container">
            <!-- Booking form will be loaded here -->
        </div>

        <div class="giveaway-cta" style="margin-top: 2rem;">
            <a href="#" class="giveaway-button secondary" id="back-to-home" data-en="Back to Home" data-it="Torna alla Home">Back to Home</a>
        </div>
    </div>
</div>

<script>
(function() {
    // Load booking form into giveaway section
    fetch('/unified-booking-form')
        .then(r => r.text())
        .then(html => {
            const formContainer = document.getElementById('giveaway-form-container');
            if (formContainer) {
                formContainer.innerHTML = html;

                // Execute inline scripts from the form
                const scripts = formContainer.querySelectorAll('script');
                scripts.forEach(oldScript => {
                    const newScript = document.createElement('script');
                    if (oldScript.src) {
                        newScript.src = oldScript.src;
                    } else {
                        newScript.textContent = oldScript.textContent;
                    }
                    document.body.appendChild(newScript);
                    oldScript.remove();
                });

                // Apply saved language after form loads
                const savedLang = localStorage.getItem('selectedLanguage') || 'en';
                document.querySelectorAll('[data-en]').forEach(element => {
                    const text = element.getAttribute('data-' + savedLang);
                    if (text) {
                        element.textContent = text;
                    }
                });
            }
        })
        .catch(error => console.error('Error loading booking form:', error));

    // Apply saved language to static elements
    const savedLang = localStorage.getItem('selectedLanguage') || 'en';
    document.querySelectorAll('[data-en]').forEach(element => {
        const text = element.getAttribute('data-' + savedLang);
        if (text) {
            element.textContent = text;
        }
    });

    // Note: Back button handler is now in index.html using event delegation for better reliability
})();
</script>
