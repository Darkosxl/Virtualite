<% if has_content %>
<!-- Social media platform fields -->
<div class="mb-6 space-y-4">
    <label class="block text-white font-semibold mb-3">Hangi platformda içerik üretiyorsunuz? *</label>
    <div class="grid grid-cols-2 gap-3">
        <label class="flex items-center cursor-pointer p-3 rounded-lg bg-white bg-opacity-5 hover:bg-opacity-10 transition-all">
            <input type="radio" name="social_platform" value="TikTok" required class="sr-only">
            <div class="w-5 h-5 border-2 border-white rounded-full mr-3 flex items-center justify-center">
                <div class="w-2 h-2 bg-white rounded-full hidden radio-dot"></div>
            </div>
            <span class="text-white font-medium">TikTok</span>
        </label>
        <label class="flex items-center cursor-pointer p-3 rounded-lg bg-white bg-opacity-5 hover:bg-opacity-10 transition-all">
            <input type="radio" name="social_platform" value="Instagram" required class="sr-only">
            <div class="w-5 h-5 border-2 border-white rounded-full mr-3 flex items-center justify-center">
                <div class="w-2 h-2 bg-white rounded-full hidden radio-dot"></div>
            </div>
            <span class="text-white font-medium">Instagram</span>
        </label>
        <label class="flex items-center cursor-pointer p-3 rounded-lg bg-white bg-opacity-5 hover:bg-opacity-10 transition-all">
            <input type="radio" name="social_platform" value="YouTube" required class="sr-only">
            <div class="w-5 h-5 border-2 border-white rounded-full mr-3 flex items-center justify-center">
                <div class="w-2 h-2 bg-white rounded-full hidden radio-dot"></div>
            </div>
            <span class="text-white font-medium">YouTube</span>
        </label>
        <label class="flex items-center cursor-pointer p-3 rounded-lg bg-white bg-opacity-5 hover:bg-opacity-10 transition-all">
            <input type="radio" name="social_platform" value="Diğer" required class="sr-only">
            <div class="w-5 h-5 border-2 border-white rounded-full mr-3 flex items-center justify-center">
                <div class="w-2 h-2 bg-white rounded-full hidden radio-dot"></div>
            </div>
            <span class="text-white font-medium">Diğer</span>
        </label>
    </div>
</div>

<div class="mb-6">
    <label class="block text-white font-semibold mb-2">Kullanıcı Adınız / Kanal Adınız *</label>
    <input type="text" 
           name="social_id" 
           required 
           class="w-full px-4 py-3 rounded-xl bg-white bg-opacity-10 border border-white border-opacity-20 text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent"
           placeholder="@kullaniciadi veya kanal adı">
    <p class="text-gray-300 text-sm mt-1">Örnek: @johndoe, Kanal Adı, vb.</p>
</div>
<% else %>
<!-- No content experience - maybe add some encouraging text -->
<div class="mb-6 p-4 bg-gradient-to-r from-purple-500 from-purple-600 bg-opacity-10 rounded-xl border border-purple-300 border-opacity-20">
    <p class="text-white text-center">
        <span class="text-purple-200 font-semibold">Harika!</span> 
        İlk içerik üretiminizde size rehberlik edebiliriz. Bu konuşmada size en uygun stratejiyi belirleyeceğiz.
    </p>
</div>
<% end %>
