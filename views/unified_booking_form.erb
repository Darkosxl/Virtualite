<script>
// Custom Date and Time Picker
(function() {
    const dateInput = document.getElementById('selected-date');
    const dateDisplay = document.getElementById('date-display');
    const dateDisplayText = document.getElementById('date-display-text');
    const datePicker = document.getElementById('custom-date-picker');
    const weekContainer = document.getElementById('week-dates-container');
    const prevWeekBtn = document.getElementById('prev-week-btn');
    const nextWeekBtn = document.getElementById('next-week-btn');
    const timeSelectionField = document.getElementById('time-selection-field');
    const timePickerContainer = document.getElementById('custom-time-picker');
    const timeInput = document.getElementById('selected-time');

    const today = new Date();
    const maxBookingDate = new Date(today);
    maxBookingDate.setDate(today.getDate() + 35); // 5 weeks

    let currentWeekStart = null;
    let selectedDate = null;
    let isRendering = false; // Prevent simultaneous renders
    const allTimeSlots = ['10:00', '10:30', '11:00', '11:30', '12:00', '12:30', '13:00', '13:30', '14:00', '14:30', '15:00', '15:30', '16:00', '16:30', '17:00', '17:30', '18:00', '18:30', '19:00', '19:30', '20:00', '20:30', '21:00', '21:30'];
    
    // Cache for API responses
    const apiCache = {
        data: {},
        set: function(dateStr, response) {
            this.data[dateStr] = {
                response: response,
                timestamp: Date.now()
            };
        },
        get: function(dateStr) {
            const cached = this.data[dateStr];
            if (!cached) return null;
            
            // Cache expires after 5 minutes
            if (Date.now() - cached.timestamp > 300000) {
                delete this.data[dateStr];
                return null;
            }
            return cached.response;
        }
    };

    // Get start of week (Monday)
    function getMonday(d) {
        const date = new Date(d);
        const day = date.getDay();
        const diff = date.getDate() - day + (day === 0 ? -6 : 1); // Adjust when day is Sunday
        return new Date(date.setDate(diff));
    }

    // Format date for display
    function formatDateDisplay(date) {
        const days = {tr: ['Paz', 'Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt'], en: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'], it: ['Dom', 'Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab']};
        const lang = localStorage.getItem('selectedLanguage') || 'tr';
        return `${days[lang][date.getDay()]} ${date.getDate()}`;
    }

    // Format full date display
    function formatFullDate(date) {
        const months = {
            tr: ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'],
            en: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
            it: ['Gennaio', 'Febbraio', 'Marzo', 'Aprile', 'Maggio', 'Giugno', 'Luglio', 'Agosto', 'Settembre', 'Ottobre', 'Novembre', 'Dicembre']
        };
        const lang = localStorage.getItem('selectedLanguage') || 'tr';
        return `${date.getDate()} ${months[lang][date.getMonth()]} ${date.getFullYear()}`;
    }

    // Check if date is valid for booking
    function isDateValid(date) {
        const dateOnly = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        const todayOnly = new Date(today.getFullYear(), today.getMonth(), today.getDate());
        return dateOnly > todayOnly && dateOnly <= maxBookingDate && date.getDay() !== 0;
    }

    // Render week dates
    function renderWeek(weekStart) {
        console.log('   🎨 renderWeek() called');
        console.time('   ⏱️ renderWeek_TOTAL');

        // Prevent simultaneous renders
        if (isRendering) {
            console.log('   ⚠️ Already rendering, skipping...');
            return;
        }
        isRendering = true;

        console.time('   ⏱️ generate_7_dates');
        const dates = [];

        // Generate 7 days starting from Monday
        for (let i = 0; i < 7; i++) {
            const date = new Date(weekStart);
            date.setDate(weekStart.getDate() + i);
            dates.push(date);
        }
        console.timeEnd('   ⏱️ generate_7_dates');

        console.time('   ⏱️ check_and_clear_DOM');
        // Only clear DOM if it's empty (first render)
        const isFirstRender = weekContainer.children.length === 0;
        console.log('   Is first render:', isFirstRender);
        if (isFirstRender) {
            weekContainer.innerHTML = '';
        }
        console.timeEnd('   ⏱️ check_and_clear_DOM');

        console.time('   ⏱️ create_7_buttons');
        console.log('   🔨 Creating 7 date buttons (NO API CALLS)');
        // NO API CALLS - just render based on date validity
        dates.forEach((date, index) => {
            const isValid = isDateValid(date);
            const isSunday = date.getDay() === 0;
            const isDisabled = !isValid || isSunday;

            let btn;
            
            // Reuse existing button or create new one
            if (isFirstRender) {
                btn = document.createElement('button');
                btn.type = 'button';
                weekContainer.appendChild(btn);
            } else {
                btn = weekContainer.children[index];
                if (!btn) {
                    btn = document.createElement('button');
                    btn.type = 'button';
                    weekContainer.appendChild(btn);
                }
                // Clear existing event listeners by cloning
                const newBtn = btn.cloneNode(false);
                btn.parentNode.replaceChild(newBtn, btn);
                btn = newBtn;
            }
            
            btn.textContent = formatDateDisplay(date);
            btn.dataset.date = date.toISOString().split('T')[0];

            // Styling
            if (isDisabled) {
                btn.style.cssText = `
                    background: rgba(255, 255, 255, 0.05);
                    color: rgba(255, 255, 255, 0.3);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    border-radius: 0.5rem;
                    padding: 0.75rem 0.5rem;
                    cursor: not-allowed;
                    font-size: 0.875rem;
                    flex: 1;
                    min-width: 70px;
                    text-align: center;
                    transition: all 0.3s;
                `;
                btn.disabled = true;
            } else {
                btn.style.cssText = `
                    background: rgba(255, 255, 255, 0.1);
                    color: white;
                    border: 1px solid rgba(255, 255, 255, 0.3);
                    border-radius: 0.5rem;
                    padding: 0.75rem 0.5rem;
                    cursor: pointer;
                    font-size: 0.875rem;
                    flex: 1;
                    min-width: 70px;
                    text-align: center;
                    transition: all 0.3s;
                `;
                btn.disabled = false;

                btn.addEventListener('mouseenter', function() {
                    if (!this.classList.contains('selected')) {
                        this.style.background = 'rgba(242, 82, 46, 0.3)';
                        this.style.borderColor = '#F2522E';
                    }
                });

                btn.addEventListener('mouseleave', function() {
                    if (!this.classList.contains('selected')) {
                        this.style.background = 'rgba(255, 255, 255, 0.1)';
                        this.style.borderColor = 'rgba(255, 255, 255, 0.3)';
                    }
                });

                btn.addEventListener('click', async function() {
                    selectedDate = date;
                    dateInput.value = this.dataset.date;
                    dateDisplayText.textContent = formatFullDate(date);
                    dateDisplay.style.color = 'white';
                    // Don't hide the date picker - keep it visible

                    // Mark as selected
                    weekContainer.querySelectorAll('button').forEach(b => {
                        b.classList.remove('selected');
                        if (!b.disabled) {
                            b.style.background = 'rgba(255, 255, 255, 0.1)';
                            b.style.borderColor = 'rgba(255, 255, 255, 0.3)';
                        }
                    });
                    this.classList.add('selected');
                    this.style.background = 'rgba(242, 82, 46, 0.3)';
                    this.style.borderColor = '#F2522E';

                    // Load time slots
                    await loadTimeSlots(this.dataset.date);
                    validateUnifiedForm();
                });
            }
        });
        console.timeEnd('   ⏱️ create_7_buttons');

        console.time('   ⏱️ update_nav_buttons');
        // Update navigation buttons state
        const firstWeekMonday = getMonday(new Date(today.getTime() + 86400000)); // Tomorrow's week
        const lastValidMonday = getMonday(maxBookingDate);

        const isPrevDisabled = weekStart <= firstWeekMonday;
        const isNextDisabled = weekStart >= lastValidMonday;

        prevWeekBtn.disabled = isPrevDisabled;
        prevWeekBtn.style.opacity = isPrevDisabled ? '0.3' : '1';
        prevWeekBtn.style.cursor = isPrevDisabled ? 'not-allowed' : 'pointer';

        nextWeekBtn.disabled = isNextDisabled;
        nextWeekBtn.style.opacity = isNextDisabled ? '0.3' : '1';
        nextWeekBtn.style.cursor = isNextDisabled ? 'not-allowed' : 'pointer';
        console.timeEnd('   ⏱️ update_nav_buttons');

        // Unlock rendering
        isRendering = false;
        console.timeEnd('   ⏱️ renderWeek_TOTAL');
        console.log('   ✅ renderWeek() complete');
    }

    // Load time slots for selected date
    async function loadTimeSlots(dateStr) {
        console.log('   🕐 loadTimeSlots() called for:', dateStr);
        console.time('   ⏱️ loadTimeSlots_TOTAL');
        try {
            let data;

            console.time('   ⏱️ check_cache');
            // Check cache first
            const cached = apiCache.get(dateStr);
            console.timeEnd('   ⏱️ check_cache');

            if (cached) {
                console.log('   ✅ Using cached data');
                data = cached;
            } else {
                console.log('   🌐 Cache miss - fetching from API');
                console.time('   ⏱️ API_CALL_/api/available-slots');
                // Fetch if not cached
                const response = await fetch(`/api/available-slots/${dateStr}`);
                console.timeEnd('   ⏱️ API_CALL_/api/available-slots');

                console.time('   ⏱️ parse_JSON');
                data = await response.json();
                console.timeEnd('   ⏱️ parse_JSON');

                // Cache the response
                apiCache.set(dateStr, data);
                console.log('   💾 Data cached');
            }

            console.time('   ⏱️ clear_time_picker');
            timePickerContainer.innerHTML = '';
            console.timeEnd('   ⏱️ clear_time_picker');

            console.time('   ⏱️ render_24_time_buttons');
            console.log('   🔨 Rendering 24 time slot buttons');
            allTimeSlots.forEach(time => {
                const isBooked = data.booked_slots && data.booked_slots.includes(time);

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = time;
                btn.dataset.time = time;

                if (isBooked) {
                    btn.style.cssText = `
                        background: rgba(255, 68, 68, 0.2);
                        color: rgba(255, 68, 68, 0.5);
                        border: 1px solid rgba(255, 68, 68, 0.3);
                        border-radius: 0.5rem;
                        padding: 0.75rem 0.5rem;
                        cursor: not-allowed;
                        font-size: 0.875rem;
                        text-decoration: line-through;
                        transition: all 0.3s;
                    `;
                    btn.disabled = true;
                } else {
                    btn.style.cssText = `
                        background: rgba(255, 255, 255, 0.1);
                        color: white;
                        border: 1px solid rgba(255, 255, 255, 0.3);
                        border-radius: 0.5rem;
                        padding: 0.75rem 0.5rem;
                        cursor: pointer;
                        font-size: 0.875rem;
                        transition: all 0.3s;
                    `;

                    btn.addEventListener('mouseenter', function() {
                        if (!this.classList.contains('selected')) {
                            this.style.background = 'rgba(242, 82, 46, 0.3)';
                            this.style.borderColor = '#F2522E';
                        }
                    });

                    btn.addEventListener('mouseleave', function() {
                        if (!this.classList.contains('selected')) {
                            this.style.background = 'rgba(255, 255, 255, 0.1)';
                            this.style.borderColor = 'rgba(255, 255, 255, 0.3)';
                        }
                    });

                    btn.addEventListener('click', function() {
                        timeInput.value = this.dataset.time;

                        timePickerContainer.querySelectorAll('button').forEach(b => {
                            b.classList.remove('selected');
                            if (!b.disabled) {
                                b.style.background = 'rgba(255, 255, 255, 0.1)';
                                b.style.borderColor = 'rgba(255, 255, 255, 0.3)';
                            }
                        });
                        this.classList.add('selected');
                        this.style.background = 'linear-gradient(45deg, #F2522E, #F24535)';
                        this.style.borderColor = '#F24535';

                        validateUnifiedForm();
                    });
                }

                timePickerContainer.appendChild(btn);
            });
            console.timeEnd('   ⏱️ render_24_time_buttons');

            console.time('   ⏱️ show_time_field');
            timeSelectionField.style.display = 'block';
            console.timeEnd('   ⏱️ show_time_field');

            console.timeEnd('   ⏱️ loadTimeSlots_TOTAL');
            console.log('   ✅ loadTimeSlots() complete');
        } catch (error) {
            console.timeEnd('   ⏱️ loadTimeSlots_TOTAL');
            console.error('❌ Error loading time slots:', error);
        }
    }

    // Toggle date picker
    dateDisplay.addEventListener('click', function() {
        console.log('📅 ========== DATE PICKER CLICKED ==========');
        console.time('⏱️ TOTAL_CLICK_TO_RENDER');

        console.time('⏱️ visibility_check');
        const isVisible = datePicker.style.display !== 'none';
        console.timeEnd('⏱️ visibility_check');
        console.log('   Is currently visible:', isVisible);

        console.time('⏱️ toggle_display');
        datePicker.style.display = isVisible ? 'none' : 'block';
        console.timeEnd('⏱️ toggle_display');

        if (!isVisible && !currentWeekStart) {
            console.log('   🔄 First time opening - initializing week');

            console.time('⏱️ calculate_tomorrow');
            const tomorrow = new Date(today);
            tomorrow.setDate(today.getDate() + 1);
            console.timeEnd('⏱️ calculate_tomorrow');

            console.time('⏱️ get_monday');
            currentWeekStart = getMonday(tomorrow);
            console.timeEnd('⏱️ get_monday');
            console.log('   Week starts on:', currentWeekStart.toISOString().split('T')[0]);

            console.time('⏱️ render_week');
            renderWeek(currentWeekStart);
            console.timeEnd('⏱️ render_week');
        }
        console.timeEnd('⏱️ TOTAL_CLICK_TO_RENDER');
        console.log('✅ ========== DATE PICKER READY ==========');
    });

    // Week navigation
    prevWeekBtn.addEventListener('click', function() {
        if (!this.disabled && !isRendering) {
            const newWeekStart = new Date(currentWeekStart);
            newWeekStart.setDate(newWeekStart.getDate() - 7);
            currentWeekStart = newWeekStart;
            renderWeek(currentWeekStart);
        }
    });

    nextWeekBtn.addEventListener('click', function() {
        if (!this.disabled && !isRendering) {
            const newWeekStart = new Date(currentWeekStart);
            newWeekStart.setDate(newWeekStart.getDate() + 7);
            currentWeekStart = newWeekStart;
            renderWeek(currentWeekStart);
        }
    });

    // Handle occupation dropdown selection
    const occupationSelect = document.getElementById('occupation-select');
    const customOccupationInput = document.getElementById('custom-occupation-input');

    if (occupationSelect) {
        occupationSelect.addEventListener('change', function() {
            if (this.value === 'custom') {
                customOccupationInput.style.display = 'block';
                customOccupationInput.required = true;
            } else {
                customOccupationInput.style.display = 'none';
                customOccupationInput.required = false;
                customOccupationInput.value = '';
            }
            validateUnifiedForm();
        });
    }

    // Handle custom occupation input changes
    if (customOccupationInput) {
        customOccupationInput.addEventListener('input', validateUnifiedForm);
    }

    // Handle budget dropdown selection
    const budgetSelect = document.getElementById('budget-select');
    if (budgetSelect) {
        budgetSelect.addEventListener('change', validateUnifiedForm);
    }

    // Handle social platform checkbox selection
    const socialCheckboxes = document.querySelectorAll('.social-checkbox');
    console.log('Found social checkboxes:', socialCheckboxes.length);

    socialCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const platform = this.getAttribute('data-platform');
            const usernameInput = document.querySelector(`input.platform-username[data-platform="${platform}"]`);

            console.log('Checkbox changed:', platform, 'checked:', this.checked);
            console.log('Username input found:', usernameInput);

            if (usernameInput) {
                if (this.checked) {
                    usernameInput.style.display = 'block';
                } else {
                    usernameInput.style.display = 'none';
                    usernameInput.value = '';
                }
            }

            validateUnifiedForm();
        });
    });

    // Handle username input changes
    document.querySelectorAll('.platform-username').forEach(input => {
        input.addEventListener('input', validateUnifiedForm);
    });

    // Form validation function
    function validateUnifiedForm() {
        const checkboxes = document.querySelectorAll('.social-checkbox');
        const submitBtn = document.getElementById('submit-booking-btn');
        const occupationSelect = document.getElementById('occupation-select');
        const customOccupationInput = document.getElementById('custom-occupation-input');
        const budgetSelect = document.getElementById('budget-select');

        // Check occupation validation
        let hasValidOccupation = false;
        if (occupationSelect && occupationSelect.value && occupationSelect.value !== '') {
            if (occupationSelect.value === 'custom') {
                hasValidOccupation = customOccupationInput && customOccupationInput.value.trim() !== '';
            } else {
                hasValidOccupation = true;
            }
        }

        // Check budget/reason validation
        let hasValidBudget = budgetSelect && budgetSelect.value && budgetSelect.value !== '';

        // Check social media selection validation
        let hasValidSocialSelection = false;
        checkboxes.forEach(checkbox => {
            if (checkbox.checked) {
                const platform = checkbox.getAttribute('data-platform');
                const usernameInput = document.querySelector(`input.platform-username[data-platform="${platform}"]`);
                if (usernameInput && usernameInput.value.trim() !== '') {
                    hasValidSocialSelection = true;
                }
            }
        });

        // All three validations must pass: occupation, budget, and at least one social platform
        if (hasValidOccupation && hasValidBudget && hasValidSocialSelection) {
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
            submitBtn.style.cursor = 'pointer';
        } else {
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.5';
            submitBtn.style.cursor = 'not-allowed';
        }
    }

    // Initial validation check
    validateUnifiedForm();

    // Handle form submission with reCAPTCHA
    const form = document.getElementById('unified-booking-form');
    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const submitBtn = document.getElementById('submit-booking-btn');
            if (submitBtn.disabled) {
                return;
            }

            // Check if reCAPTCHA is available
            if (typeof grecaptcha !== 'undefined') {
                grecaptcha.ready(function() {
                    grecaptcha.execute('6LfyocYrAAAAAAO2wxWMTCTxNWrbS-qVSU_woJjU', {action: 'submit'}).then(function(token) {
                        document.getElementById('recaptchaResponse').value = token;
                        form.submit();
                    });
                });
            } else {
                form.submit();
            }
        });
    }

    // Update language field when language changes
    function updateLanguageField() {
        const savedLang = localStorage.getItem('selectedLanguage') || 'tr';
        const languageInput = document.getElementById('selectedLanguageInput');
        if (languageInput) {
            languageInput.value = savedLang;
        }
    }

    updateLanguageField();

    const originalSetItem = localStorage.setItem;
    localStorage.setItem = function(key, value) {
        originalSetItem.call(this, key, value);
        if (key === 'selectedLanguage') {
            updateLanguageField();
        }
    };

    // Warm up database connection on page load
    console.time('DB_WARMUP');
    fetch('/api/warmup')
        .then(response => {
            console.timeEnd('DB_WARMUP');
            console.log('✅ Database connection warmed up');
        })
        .catch(err => {
            console.timeEnd('DB_WARMUP');
            console.log('❌ Warmup failed:', err);
        });
})();
</script>
