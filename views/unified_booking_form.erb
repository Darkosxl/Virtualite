<script>
// SIMPLE Custom Calendar
(function() {
    const dateInput = document.getElementById('selected-date');
    const dateDisplay = document.getElementById('date-display');
    const dateDisplayText = document.getElementById('date-display-text');
    const datePicker = document.getElementById('custom-date-picker');
    const calendarGrid = document.getElementById('calendar-grid');
    const monthYearDisplay = document.getElementById('calendar-month-year');
    const prevMonthBtn = document.getElementById('prev-month-btn');
    const nextMonthBtn = document.getElementById('next-month-btn');
    const timeSelectionField = document.getElementById('time-selection-field');
    const timePickerContainer = document.getElementById('custom-time-picker');
    const timeInput = document.getElementById('selected-time');

    const today = new Date();
    let currentMonth = today.getMonth();
    let currentYear = today.getFullYear();
    let selectedDate = null;

    const allTimeSlots = ['10:00', '10:30', '11:00', '11:30', '12:00', '12:30', '13:00', '13:30', '14:00', '14:30', '15:00', '15:30', '16:00', '16:30', '17:00', '17:30', '18:00', '18:30', '19:00', '19:30', '20:00', '20:30', '21:00', '21:30'];
    
    const months = {
        tr: ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'],
        en: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
        it: ['Gennaio', 'Febbraio', 'Marzo', 'Aprile', 'Maggio', 'Giugno', 'Luglio', 'Agosto', 'Settembre', 'Ottobre', 'Novembre', 'Dicembre']
    };

    // Format full date display
    function formatFullDate(date) {
        const lang = localStorage.getItem('selectedLanguage') || 'tr';
        return `${date.getDate()} ${months[lang][date.getMonth()]} ${date.getFullYear()}`;
    }

    // Check if date is valid for booking (tomorrow onwards, no Sundays)
    function isDateValid(date) {
        const dateOnly = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        const todayOnly = new Date(today.getFullYear(), today.getMonth(), today.getDate());
        return dateOnly > todayOnly && date.getDay() !== 0;
    }

    // Render calendar for current month (grid layout)
    function renderCalendar() {
        const lang = localStorage.getItem('selectedLanguage') || 'tr';
        monthYearDisplay.textContent = `${months[lang][currentMonth]} ${currentYear}`;

        calendarGrid.innerHTML = '';

        // Add day headers (S M T W T F S)
        const dayLetters = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
        dayLetters.forEach((letter, index) => {
            const header = document.createElement('div');
            header.textContent = letter;
            header.style.cssText = `
                text-align: center;
                font-size: 0.75rem;
                font-weight: 700;
                color: ${index === 0 ? 'rgba(242, 69, 53, 0.6)' : 'rgba(255, 255, 255, 0.5)'};
                padding: 0.5rem 0;
            `;
            calendarGrid.appendChild(header);
        });

        // Get first day of month and days in month
        const firstDay = new Date(currentYear, currentMonth, 1).getDay();
        const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();

        // Add empty cells for days before month starts
        for (let i = 0; i < firstDay; i++) {
            const emptyCell = document.createElement('div');
            calendarGrid.appendChild(emptyCell);
        }

        // Add day buttons
        for (let day = 1; day <= daysInMonth; day++) {
            const date = new Date(currentYear, currentMonth, day);
            const isSunday = date.getDay() === 0;
            const isValid = isDateValid(date);

            // Create container for each day
            const dayContainer = document.createElement('div');
            dayContainer.style.cssText = `
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
            `;

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = day;
            btn.dataset.date = date.toISOString().split('T')[0];

            // Circular button styling
            if (isSunday) {
                btn.style.cssText = `
                    width: 48px;
                    height: 48px;
                    border-radius: 50%;
                    background: rgba(242, 69, 53, 0.1);
                    color: rgba(242, 69, 53, 0.5);
                    border: none;
                    cursor: not-allowed;
                    font-size: 0.875rem;
                    font-weight: 700;
                    transition: all 0.2s;
                    position: relative;
                `;
                btn.disabled = true;

                // Add dot indicator for today if it's Sunday
                if (date.toDateString() === today.toDateString()) {
                    const dot = document.createElement('span');
                    dot.style.cssText = `
                        position: absolute;
                        bottom: 4px;
                        left: 50%;
                        transform: translateX(-50%);
                        width: 4px;
                        height: 4px;
                        border-radius: 50%;
                        background: rgba(242, 69, 53, 0.6);
                    `;
                    btn.appendChild(dot);
                }
            } else if (!isValid) {
                btn.style.cssText = `
                    width: 48px;
                    height: 48px;
                    border-radius: 50%;
                    background: transparent;
                    color: rgba(255, 255, 255, 0.2);
                    border: none;
                    cursor: not-allowed;
                    font-size: 0.875rem;
                    font-weight: 600;
                    transition: all 0.2s;
                `;
                btn.disabled = true;
            } else {
                const isToday = date.toDateString() === today.toDateString();
                btn.style.cssText = `
                    width: 48px;
                    height: 48px;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.1);
                    color: white;
                    border: none;
                    cursor: pointer;
                    font-size: 0.875rem;
                    font-weight: 700;
                    transition: all 0.2s;
                    position: relative;
                `;

                // Add dot for today
                if (isToday) {
                    const dot = document.createElement('span');
                    dot.style.cssText = `
                        position: absolute;
                        bottom: 4px;
                        left: 50%;
                        transform: translateX(-50%);
                        width: 4px;
                        height: 4px;
                        border-radius: 50%;
                        background: rgba(242, 82, 46, 0.8);
                    `;
                    btn.appendChild(dot);
                }

                btn.addEventListener('mouseenter', function() {
                    if (!this.classList.contains('selected')) {
                        this.style.background = 'linear-gradient(135deg, #F2522E, #F24535)';
                        this.style.transform = 'scale(1.1)';
                    }
                });

                btn.addEventListener('mouseleave', function() {
                    if (!this.classList.contains('selected')) {
                        this.style.background = 'rgba(255, 255, 255, 0.1)';
                        this.style.transform = 'scale(1)';
                    }
                });

                btn.addEventListener('click', async function() {
                    selectedDate = date;
                    dateInput.value = this.dataset.date;
                    dateDisplayText.textContent = formatFullDate(date);
                    dateDisplay.style.color = 'white';

                    // Update selected styling
                    calendarGrid.querySelectorAll('button').forEach(b => {
                        b.classList.remove('selected');
                        if (!b.disabled) {
                            b.style.background = 'rgba(255, 255, 255, 0.1)';
                            b.style.transform = 'scale(1)';
                        }
                    });
                    this.classList.add('selected');
                    this.style.background = 'linear-gradient(135deg, #F2522E, #F24535)';
                    this.style.transform = 'scale(1.1)';
                    this.style.boxShadow = '0 4px 12px rgba(242, 69, 53, 0.4)';

                    // Show time picker in calendar modal
                    await showTimePickerInCalendar();
                    validateUnifiedForm();
                });
            }

            dayContainer.appendChild(btn);
            calendarGrid.appendChild(dayContainer);
        }
    }

    // Show time picker in calendar modal
    async function showTimePickerInCalendar() {
        const dateStr = dateInput.value;
        if (!dateStr) return;

        const calendarDateView = document.getElementById('calendar-date-view');
        const calendarTimeSection = document.getElementById('calendar-time-picker-section');
        const calendarTimeGrid = document.getElementById('calendar-time-grid');
        const backBtn = document.getElementById('back-to-date-btn');
        const selectedDateDisplay = document.getElementById('selected-date-display');

        // Hide date view, show time view
        calendarDateView.style.display = 'none';
        calendarTimeSection.style.display = 'block';
        backBtn.style.display = 'flex';

        // Update the date display in time picker header
        if (selectedDate) {
            selectedDateDisplay.textContent = formatFullDate(selectedDate);
        }

        calendarTimeGrid.innerHTML = '<p style="color: rgba(255,255,255,0.7); text-align: center; grid-column: 1/-1;">Loading...</p>';

        try {
            const response = await fetch(`/api/available-slots/${dateStr}`);
            const data = await response.json();

            calendarTimeGrid.innerHTML = '';

            allTimeSlots.forEach(time => {
                const isBooked = data.booked_slots && data.booked_slots.includes(time);

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = time;
                btn.dataset.time = time;

                if (isBooked) {
                    btn.style.cssText = `
                        background: rgba(242, 69, 53, 0.1);
                        color: rgba(242, 69, 53, 0.5);
                        border: none;
                        border-radius: 0.5rem;
                        padding: 0.625rem;
                        cursor: not-allowed;
                        font-size: 0.8125rem;
                        font-weight: 600;
                        text-decoration: line-through;
                        transition: all 0.2s;
                    `;
                    btn.disabled = true;
                } else {
                    btn.style.cssText = `
                        background: rgba(255, 255, 255, 0.1);
                        color: white;
                        border: none;
                        border-radius: 0.5rem;
                        padding: 0.625rem;
                        cursor: pointer;
                        font-size: 0.8125rem;
                        font-weight: 600;
                        transition: all 0.2s;
                    `;

                    btn.addEventListener('mouseenter', function() {
                        if (!this.classList.contains('selected')) {
                            this.style.background = 'linear-gradient(135deg, #F2522E, #F24535)';
                        }
                    });

                    btn.addEventListener('mouseleave', function() {
                        if (!this.classList.contains('selected')) {
                            this.style.background = 'rgba(255, 255, 255, 0.1)';
                        }
                    });

                    btn.addEventListener('click', function() {
                        timeInput.value = this.dataset.time;

                        calendarTimeGrid.querySelectorAll('button').forEach(b => {
                            b.classList.remove('selected');
                            if (!b.disabled) {
                                b.style.background = 'rgba(255, 255, 255, 0.1)';
                            }
                        });
                        this.classList.add('selected');
                        this.style.background = 'linear-gradient(135deg, #F2522E, #F24535)';
                        this.style.boxShadow = '0 2px 8px rgba(242, 69, 53, 0.3)';

                        // Also update the external time selection field
                        timeSelectionField.style.display = 'block';

                        // Close calendar modal after time selection
                        setTimeout(() => closeCalendarModal(), 400);

                        validateUnifiedForm();
                    });
                }

                calendarTimeGrid.appendChild(btn);
            });
        } catch (error) {
            console.error('Error loading time slots:', error);
            calendarTimeGrid.innerHTML = '<p style="color: rgba(255,255,255,0.7); text-align: center; grid-column: 1/-1;">Error loading times</p>';
        }
    }

    // Show time picker and check database for booked slots (legacy function for external time picker)
    async function showTimePicker() {
        const dateStr = dateInput.value;
        if (!dateStr) return;

        timePickerContainer.innerHTML = '<p style="color: white; text-align: center;">Loading times...</p>';
        timeSelectionField.style.display = 'block';

        try {
            // CHECK DATABASE for booked slots
            const response = await fetch(`/api/available-slots/${dateStr}`);
            const data = await response.json();

            timePickerContainer.innerHTML = '';

            // Show all time slots with proper styling
            allTimeSlots.forEach(time => {
                const isBooked = data.booked_slots && data.booked_slots.includes(time);

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = time;
                btn.dataset.time = time;

                if (isBooked) {
                    // Booked slot - disabled with red
                    btn.style.cssText = `
                        background: rgba(255, 0, 0, 0.2);
                        color: rgba(255, 0, 0, 0.5);
                        border: 2px solid rgba(255, 0, 0, 0.3);
                        border-radius: 0.5rem;
                        padding: 0.75rem 0.5rem;
                        cursor: not-allowed;
                        font-size: 0.875rem;
                        text-decoration: line-through;
                        transition: all 0.3s;
                    `;
                    btn.disabled = true;
                } else {
                    // Available slot - clickable
                    btn.style.cssText = `
                        background: rgba(255, 255, 255, 0.1);
                        color: white;
                        border: 2px solid rgba(255, 255, 255, 0.3);
                        border-radius: 0.5rem;
                        padding: 0.75rem 0.5rem;
                        cursor: pointer;
                        font-size: 0.875rem;
                        transition: all 0.3s;
                    `;

                    btn.addEventListener('mouseenter', function() {
                        if (!this.classList.contains('selected')) {
                            this.style.background = 'linear-gradient(135deg, #F2522E, #F24535)';
                            this.style.borderColor = '#F2522E';
                        }
                    });

                    btn.addEventListener('mouseleave', function() {
                        if (!this.classList.contains('selected')) {
                            this.style.background = 'rgba(255, 255, 255, 0.1)';
                            this.style.borderColor = 'rgba(255, 255, 255, 0.3)';
                        }
                    });

                    btn.addEventListener('click', function() {
                        timeInput.value = this.dataset.time;

                        timePickerContainer.querySelectorAll('button').forEach(b => {
                            b.classList.remove('selected');
                            if (!b.disabled) {
                                b.style.background = 'rgba(255, 255, 255, 0.1)';
                                b.style.borderColor = 'rgba(255, 255, 255, 0.3)';
                            }
                        });
                        this.classList.add('selected');
                        this.style.background = 'linear-gradient(135deg, #F2522E, #F24535)';
                        this.style.borderColor = '#F24535';

                        validateUnifiedForm();
                    });
                }

                timePickerContainer.appendChild(btn);
            });
        } catch (error) {
            console.error('Error loading time slots:', error);
            timePickerContainer.innerHTML = '<p style="color: rgba(255,255,255,0.7); text-align: center;">Error loading times. Please try again.</p>';
        }
    }

    // Toggle date picker modal
    const modalOverlay = document.getElementById('calendar-modal-overlay');
    const closeCalendarBtn = document.getElementById('close-calendar-btn');
    const backToDateBtn = document.getElementById('back-to-date-btn');
    
    function openCalendarModal() {
        modalOverlay.style.display = 'block';
        datePicker.style.display = 'block';
        document.body.style.overflow = 'hidden'; // Prevent background scrolling
        
        // Show date view, hide time view
        showDateView();
        renderCalendar();
    }
    
    function closeCalendarModal() {
        modalOverlay.style.display = 'none';
        datePicker.style.display = 'none';
        document.body.style.overflow = ''; // Restore scrolling

        // Reset to date view
        showDateView();
    }

    function showDateView() {
        const calendarDateView = document.getElementById('calendar-date-view');
        const calendarTimeSection = document.getElementById('calendar-time-picker-section');
        const backBtn = document.getElementById('back-to-date-btn');

        calendarDateView.style.display = 'block';
        calendarTimeSection.style.display = 'none';
        backBtn.style.display = 'none';
    }
    
    dateDisplay.addEventListener('click', openCalendarModal);
    closeCalendarBtn.addEventListener('click', closeCalendarModal);
    modalOverlay.addEventListener('click', closeCalendarModal); // Close on overlay click
    
    // Back button to return to date selection
    backToDateBtn.addEventListener('click', function() {
        showDateView();
        renderCalendar();
    });

    // Month navigation
    prevMonthBtn.addEventListener('click', function() {
        currentMonth--;
        if (currentMonth < 0) {
            currentMonth = 11;
            currentYear--;
        }
        renderCalendar();
    });

    nextMonthBtn.addEventListener('click', function() {
        currentMonth++;
        if (currentMonth > 11) {
            currentMonth = 0;
            currentYear++;
        }
        renderCalendar();
    });

    // Handle occupation dropdown selection
    const occupationSelect = document.getElementById('occupation-select');
    const customOccupationInput = document.getElementById('custom-occupation-input');

    if (occupationSelect) {
        occupationSelect.addEventListener('change', function() {
            if (this.value === 'custom') {
                customOccupationInput.style.display = 'block';
                customOccupationInput.required = true;
            } else {
                customOccupationInput.style.display = 'none';
                customOccupationInput.required = false;
                customOccupationInput.value = '';
            }
            validateUnifiedForm();
        });
    }

    // Handle custom occupation input changes
    if (customOccupationInput) {
        customOccupationInput.addEventListener('input', validateUnifiedForm);
    }

    // Handle budget dropdown selection
    const budgetSelect = document.getElementById('budget-select');
    if (budgetSelect) {
        budgetSelect.addEventListener('change', validateUnifiedForm);
    }

    // Handle social platform checkbox selection
    const socialCheckboxes = document.querySelectorAll('.social-checkbox');
    console.log('Found social checkboxes:', socialCheckboxes.length);

    socialCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const platform = this.getAttribute('data-platform');
            const usernameInput = document.querySelector(`input.platform-username[data-platform="${platform}"]`);

            console.log('Checkbox changed:', platform, 'checked:', this.checked);
            console.log('Username input found:', usernameInput);

            if (usernameInput) {
                if (this.checked) {
                    usernameInput.style.display = 'block';
                } else {
                    usernameInput.style.display = 'none';
                    usernameInput.value = '';
                }
            }

            validateUnifiedForm();
        });
    });

    // Handle username input changes
    document.querySelectorAll('.platform-username').forEach(input => {
        input.addEventListener('input', validateUnifiedForm);
    });

    // Form validation function (no longer disables button, just for other purposes)
    function validateUnifiedForm() {
        // Validation logic removed - button is always clickable
        // Validation happens on submit
    }

    // Handle form submission with reCAPTCHA
    const form = document.getElementById('unified-booking-form');
    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const submitBtn = document.getElementById('submit-booking-btn');

            // Validate all required fields
            const requiredFields = [
                { element: document.getElementById('selected-date'), label: document.querySelector('label[data-tr="Tarih Seçin *"]'), type: 'date' },
                { element: document.getElementById('selected-time'), label: document.querySelector('label[data-tr="Saat Seçin *"]'), type: 'time' },
                { element: document.querySelector('input[name="name"]'), label: document.querySelector('label[data-tr="Adınız Soyadınız *"]'), type: 'input' },
                { element: document.querySelector('input[name="phone_number"]'), label: document.querySelector('label[data-tr="Telefon Numaranız *"]'), type: 'input' },
                { element: document.querySelector('input[name="email"]'), label: document.querySelector('label[data-tr="E-posta Adresiniz *"]'), type: 'input' },
                { element: occupationSelect, label: document.querySelector('label[data-tr="Ne işle meşgulsünüz?"]'), type: 'select' },
                { element: budgetSelect, label: document.getElementById('budget-label'), type: 'select' }
            ];

            let firstInvalidField = null;
            const lang = localStorage.getItem('selectedLanguage') || 'tr';
            const messages = {
                tr: 'Lütfen bu alanı doldurun',
                en: 'Please fill out this field',
                it: 'Si prega di compilare questo campo'
            };

            // Check each required field
            requiredFields.forEach(field => {
                if (!field.element) return;

                let isValid = true;

                if (field.type === 'input') {
                    isValid = field.element.value.trim() !== '';
                } else if (field.type === 'select') {
                    isValid = field.element.value !== '';
                } else if (field.type === 'date' || field.type === 'time') {
                    isValid = field.element.value !== '';
                }

                // Check custom occupation if selected
                if (field.element === occupationSelect && field.element.value === 'custom') {
                    const customInput = document.getElementById('custom-occupation-input');
                    if (!customInput || customInput.value.trim() === '') {
                        isValid = false;
                        field.element = customInput;
                        field.label = document.querySelector('label[data-tr="Ne işle meşgulsünüz?"]');
                    }
                }

                if (!isValid) {
                    if (!firstInvalidField) {
                        firstInvalidField = field;
                    }

                    // Flash red animation
                    const targetElement = field.type === 'date' ? document.getElementById('date-display') :
                                        field.type === 'time' ? document.getElementById('time-selection-field') :
                                        field.element;

                    if (targetElement) {
                        targetElement.style.border = '2px solid #F24535';
                        targetElement.style.animation = 'shake 0.3s';

                        setTimeout(() => {
                            targetElement.style.border = '';
                            targetElement.style.animation = '';
                        }, 1000);
                    }

                    // Show message near label
                    if (field.label && !field.label.querySelector('.validation-message')) {
                        const message = document.createElement('span');
                        message.className = 'validation-message';
                        message.textContent = ' - ' + messages[lang];
                        message.style.cssText = 'color: #F24535; font-size: 0.875rem; margin-left: 0.5rem;';
                        field.label.appendChild(message);

                        setTimeout(() => {
                            message.remove();
                        }, 3000);
                    }
                }
            });

            // Check social media validation
            const checkboxes = document.querySelectorAll('.social-checkbox');
            let hasValidSocial = false;
            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    const platform = checkbox.getAttribute('data-platform');
                    const usernameInput = document.querySelector(`input.platform-username[data-platform="${platform}"]`);
                    if (usernameInput && usernameInput.value.trim() !== '') {
                        hasValidSocial = true;
                    }
                }
            });

            if (!hasValidSocial) {
                const socialLabel = document.querySelector('label[data-tr="Hangi sosyal medya platformlarında içerik üretiyorsun?"]');
                if (socialLabel && !socialLabel.querySelector('.validation-message')) {
                    const message = document.createElement('span');
                    message.className = 'validation-message';
                    message.textContent = ' - ' + messages[lang];
                    message.style.cssText = 'color: #F24535; font-size: 0.875rem; margin-left: 0.5rem;';
                    socialLabel.appendChild(message);

                    setTimeout(() => {
                        message.remove();
                    }, 3000);
                }

                if (!firstInvalidField) {
                    firstInvalidField = { element: socialLabel, type: 'social' };
                }
            }

            // If any field is invalid, scroll to first one and stop
            if (firstInvalidField) {
                const scrollTarget = firstInvalidField.type === 'social' ? firstInvalidField.element :
                                   firstInvalidField.label || firstInvalidField.element;
                if (scrollTarget) {
                    scrollTarget.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return;
            }

            // All fields are valid, proceed with submission
            // Check if reCAPTCHA is available
            if (typeof grecaptcha !== 'undefined') {
                grecaptcha.ready(function() {
                    grecaptcha.execute('6LfyocYrAAAAAAO2wxWMTCTxNWrbS-qVSU_woJjU', {action: 'submit'}).then(function(token) {
                        document.getElementById('recaptchaResponse').value = token;
                        form.submit();
                    });
                });
            } else {
                form.submit();
            }
        });
    }

    // Update language field when language changes
    function updateLanguageField() {
        const savedLang = localStorage.getItem('selectedLanguage') || 'tr';
        const languageInput = document.getElementById('selectedLanguageInput');
        if (languageInput) {
            languageInput.value = savedLang;
        }
    }

    updateLanguageField();

    const originalSetItem = localStorage.setItem;
    localStorage.setItem = function(key, value) {
        originalSetItem.call(this, key, value);
        if (key === 'selectedLanguage') {
            updateLanguageField();
        }
    };

})();
</script>
