<style>
/* Booking form styles - matching bento grid design */
.booking-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    text-align: left;
}

.form-field {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.form-field.full-width {
    grid-column: 1 / -1;
}

.form-field label {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 700;
    font-size: clamp(0.75rem, 0.9vw, 0.875rem);
    letter-spacing: 0.02em;
}

.form-field input, .form-field select {
    width: 100%;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: rgba(20, 20, 20, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    font-size: clamp(0.875rem, 0.95vw, 1rem);
    transition: all 0.15s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.form-field input:focus, .form-field select:focus {
    outline: none;
    background: rgba(20, 20, 20, 0.6);
    border-color: rgba(242, 69, 53, 0.5);
    box-shadow: 0 0 0 3px rgba(242, 69, 53, 0.15), 0 4px 12px rgba(242, 69, 53, 0.2);
}

.form-field input::placeholder {
    color: rgba(255, 255, 255, 0.45);
}

.form-field select {
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='rgba(255,255,255,0.7)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 1.25rem center;
    padding-right: 3rem;
}

.form-field select option {
    background-color: #1a1a1a;
    color: white;
}

.form-field select option:disabled {
    color: rgba(242, 69, 53, 0.5) !important;
    background-color: rgba(20, 20, 20, 0.9) !important;
    text-decoration: line-through !important;
    font-weight: bold !important;
    cursor: not-allowed !important;
}

/* Custom checkbox styling - matching bento design */
.social-checkbox:checked + div .checkbox-dot {
    display: block !important;
}

.social-checkbox:checked + div {
    border-color: rgba(242, 69, 53, 0.8) !important;
    background: linear-gradient(135deg, rgba(242, 82, 46, 0.2), rgba(242, 69, 53, 0.15)) !important;
    box-shadow: 0 2px 8px rgba(242, 69, 53, 0.2);
}

.platform-username {
    width: 100%;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: rgba(20, 20, 20, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    font-size: clamp(0.875rem, 0.95vw, 1rem);
    transition: all 0.15s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.platform-username:focus {
    outline: none;
    background: rgba(20, 20, 20, 0.6);
    border-color: rgba(242, 69, 53, 0.5);
    box-shadow: 0 0 0 3px rgba(242, 69, 53, 0.15), 0 4px 12px rgba(242, 69, 53, 0.2);
}

.htmx-indicator {
    display: none !important;
}

.htmx-request .htmx-indicator {
    display: inline !important;
}

.htmx-request button {
    opacity: 0.7 !important;
    pointer-events: none !important;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
}

/* Submit button - matching bento card style */
#submit-booking-btn {
    background: linear-gradient(135deg, #F2522E, #F24535) !important;
    border-radius: 1rem !important;
    padding: 1.25rem 2rem !important;
    font-weight: 700 !important;
    font-size: 1.125rem !important;
    box-shadow: 0 4px 12px rgba(242, 69, 53, 0.3), 0 8px 24px rgba(0, 0, 0, 0.15) !important;
    transition: all 0.3s ease !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
}

#submit-booking-btn:not(:disabled):hover {
    transform: translateY(-0.25rem) !important;
    box-shadow: 0 6px 16px rgba(242, 69, 53, 0.4), 0 12px 32px rgba(0, 0, 0, 0.2) !important;
}

#submit-booking-btn:not(:disabled):active {
    transform: translateY(0) !important;
}

#submit-booking-btn:not(:disabled) {
    opacity: 1 !important;
    cursor: pointer !important;
}

/* Social platforms grid - works on all devices */
.social-platforms-grid > div {
    display: flex;
    flex-direction: column;
}

/* Responsive design */
@media (max-width: 768px) {
    .booking-form {
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .form-field.full-width {
        grid-column: 1;
    }

    /* Mobile: Single column for social platforms */
    .social-platforms-grid {
        grid-template-columns: 1fr !important;
        gap: 1rem !important;
    }
}
</style>

<form id="unified-booking-form" action="/submit-booking" method="post">
    <input type="hidden" name="load_time" id="loadTime" value="">
    <input type="hidden" name="g-recaptcha-response" id="recaptchaResponse">
    <input type="hidden" name="language" id="selectedLanguageInput" value="en">

    <!-- Honeypot trap -->
    <div style="position: absolute; left: -5000px;" aria-hidden="true">
        <input type="text" name="user_nickname" tabindex="-1" value="">
    </div>

    <div class="booking-form">
        <!-- Name -->
        <div class="form-field">
            <label data-en="Your Full Name *" data-it="Il Tuo Nome Completo *">Your Full Name *</label>
            <input type="text" name="name" required
                   data-placeholder-en="Enter your full name"
                   data-placeholder-it="Inserisci il tuo nome completo"
                   placeholder="Enter your full name">
        </div>

        <!-- Phone -->
        <div class="form-field">
            <label data-en="Your Phone Number *" data-it="Il Tuo Numero di Telefono *">Your Phone Number *</label>
            <input type="tel" name="phone_number" required pattern="[0-9\s\-\+\(\)]*"
                   data-placeholder-en="+1 555 123 4567"
                   data-placeholder-it="+39 555 123 456"
                   placeholder="+1 555 123 4567">
            <p style="color: rgba(255, 255, 255, 0.6); font-size: 0.75rem; margin-top: 0.5rem; line-height: 1.4;"
               data-en="Note: We will call you via WhatsApp from a +1 number"
               data-it="Nota: Ti chiameremo tramite WhatsApp da un numero +1">
                Note: We will call you via WhatsApp from a +1 number
            </p>
        </div>

        <!-- Email -->
        <div class="form-field full-width">
            <label data-en="Your Email Address *" data-it="Il Tuo Indirizzo Email *">Your Email Address *</label>
            <input type="email" name="email" required
                   data-placeholder-en="example@email.com"
                   data-placeholder-it="esempio@email.com"
                   placeholder="example@email.com">
        </div>

        <!-- Main goal question -->
        <div class="form-field full-width">
            <label id="budget-label" data-en="What's your main goal in outsourcing video editing?" data-it="Qual è il tuo obiettivo principale nell'esternalizzare il montaggio video?">What's your main goal in outsourcing video editing?</label>
            <select name="budget" id="budget-select" required>
                <option value="" data-en="Select..." data-it="Seleziona...">Select...</option>
                <option value="save_time" data-en="To save time" data-it="Per risparmiare tempo">To save time</option>
                <option value="improve_quality" data-en="Improve the quality of my videos" data-it="Migliorare la qualità dei miei video">Improve the quality of my videos</option>
                <option value="exploring" data-en="I'm just exploring for now" data-it="Sto solo esplorando per ora">I'm just exploring for now</option>
                <option value="other" data-en="Other" data-it="Altro">Other</option>
            </select>
            <input type="text" name="custom_goal" id="custom-goal-input" style="display: none; margin-top: 0.75rem;"
                   data-placeholder-en="Please specify"
                   data-placeholder-it="Si prega di specificare"
                   placeholder="Please specify">
        </div>

        <!-- Social media platforms -->
        <div class="form-field full-width">
            <label data-en="Which social media platforms do you create content on?" data-it="Su quali piattaforme social crei contenuti?">Which social media platforms do you create content on?</label>
            <div class="social-platforms-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 0.5rem;">
                <!-- TikTok -->
                <div>
                    <label style="display: flex; align-items: center; cursor: pointer; margin-bottom: 0.5rem;">
                        <input type="checkbox" name="social_platforms[]" value="tiktok" class="social-checkbox" data-platform="tiktok" style="position: absolute; left: -10000px;">
                        <div style="width: 1.25rem; height: 1.25rem; border: 2px solid rgba(255, 255, 255, 0.3); border-radius: 0.375rem; margin-right: 0.75rem; display: flex; align-items: center; justify-content: center; transition: all 0.15s ease; background: rgba(20, 20, 20, 0.3);">
                            <div class="checkbox-dot" style="width: 0.625rem; height: 0.625rem; background: linear-gradient(135deg, #F2522E, #F24535); border-radius: 0.25rem; display: none;"></div>
                        </div>
                        <span style="color: rgba(255, 255, 255, 0.9); font-weight: 600; font-size: 0.875rem;">TikTok</span>
                    </label>
                    <input type="text" name="tiktok_username" class="platform-username" data-platform="tiktok" style="display: none; margin-top: 0.5rem;"
                           data-placeholder-en="@username"
                           data-placeholder-it="@nomeutente"
                           placeholder="@username">
                </div>

                <!-- Instagram -->
                <div>
                    <label style="display: flex; align-items: center; cursor: pointer; margin-bottom: 0.5rem;">
                        <input type="checkbox" name="social_platforms[]" value="instagram" class="social-checkbox" data-platform="instagram" style="position: absolute; left: -10000px;">
                        <div style="width: 1.25rem; height: 1.25rem; border: 2px solid rgba(255, 255, 255, 0.3); border-radius: 0.375rem; margin-right: 0.75rem; display: flex; align-items: center; justify-content: center; transition: all 0.15s ease; background: rgba(20, 20, 20, 0.3);">
                            <div class="checkbox-dot" style="width: 0.625rem; height: 0.625rem; background: linear-gradient(135deg, #F2522E, #F24535); border-radius: 0.25rem; display: none;"></div>
                        </div>
                        <span style="color: rgba(255, 255, 255, 0.9); font-weight: 600; font-size: 0.875rem;">Instagram</span>
                    </label>
                    <input type="text" name="instagram_username" class="platform-username" data-platform="instagram" style="display: none; margin-top: 0.5rem;"
                           data-placeholder-en="@username"
                           data-placeholder-it="@nomeutente"
                           placeholder="@username">
                </div>

                <!-- YouTube -->
                <div>
                    <label style="display: flex; align-items: center; cursor: pointer; margin-bottom: 0.5rem;">
                        <input type="checkbox" name="social_platforms[]" value="youtube" class="social-checkbox" data-platform="youtube" style="position: absolute; left: -10000px;">
                        <div style="width: 1.25rem; height: 1.25rem; border: 2px solid rgba(255, 255, 255, 0.3); border-radius: 0.375rem; margin-right: 0.75rem; display: flex; align-items: center; justify-content: center; transition: all 0.15s ease; background: rgba(20, 20, 20, 0.3);">
                            <div class="checkbox-dot" style="width: 0.625rem; height: 0.625rem; background: linear-gradient(135deg, #F2522E, #F24535); border-radius: 0.25rem; display: none;"></div>
                        </div>
                        <span style="color: rgba(255, 255, 255, 0.9); font-weight: 600; font-size: 0.875rem;">YouTube</span>
                    </label>
                    <input type="text" name="youtube_username" class="platform-username" data-platform="youtube" style="display: none; margin-top: 0.5rem;"
                           data-placeholder-en="@channelname"
                           data-placeholder-it="@nomecanale"
                           placeholder="@channelname">
                </div>
            </div>
        </div>

        <!-- Submit button -->
        <div class="form-field full-width">
            <button type="submit" id="submit-booking-btn"
                    style="width: 100%; color: white; border: none; cursor: pointer; opacity: 1;">
                <span class="htmx-indicator" id="loading" style="display: none;">
                    <svg style="animation: spin 1s linear infinite; margin-left: -0.25rem; margin-right: 0.75rem; height: 1.25rem; width: 1.25rem; color: white; display: inline;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle style="opacity: 0.25;" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path style="opacity: 0.75;" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </span>
                <span data-en="Complete Booking" data-it="Completa Prenotazione">Complete Booking</span>
            </button>
        </div>
    </div>
</form>

<script>
(function() {
    console.log('Form script loaded');

    // Set load time for bot protection
    document.getElementById('loadTime').value = Date.now();
    console.log('Load time set:', Date.now());

    // Handle goal dropdown selection (show/hide "other" text field)
    const budgetSelect = document.getElementById('budget-select');
    const customGoalInput = document.getElementById('custom-goal-input');

    if (budgetSelect) {
        budgetSelect.addEventListener('change', function() {
            if (this.value === 'other') {
                customGoalInput.style.display = 'block';
                customGoalInput.required = true;
            } else {
                customGoalInput.style.display = 'none';
                customGoalInput.required = false;
                customGoalInput.value = '';
            }
        });
    }

    // Handle social platform checkbox selection
    const socialCheckboxes = document.querySelectorAll('.social-checkbox');
    console.log('Found social checkboxes:', socialCheckboxes.length);

    socialCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const platform = this.getAttribute('data-platform');
            const usernameInput = document.querySelector(`input.platform-username[data-platform="${platform}"]`);

            console.log('Checkbox changed:', platform, 'checked:', this.checked);
            console.log('Username input found:', usernameInput);

            if (usernameInput) {
                if (this.checked) {
                    usernameInput.style.display = 'block';
                } else {
                    usernameInput.style.display = 'none';
                    usernameInput.value = '';
                }
            }
        });
    });

    // Handle form submission with reCAPTCHA
    const form = document.getElementById('unified-booking-form');
    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const submitBtn = document.getElementById('submit-booking-btn');

            // Validate all required fields
            const requiredFields = [
                { element: document.querySelector('input[name="name"]'), label: document.querySelector('label[data-en="Your Full Name *"]'), type: 'input' },
                { element: document.querySelector('input[name="phone_number"]'), label: document.querySelector('label[data-en="Your Phone Number *"]'), type: 'input' },
                { element: document.querySelector('input[name="email"]'), label: document.querySelector('label[data-en="Your Email Address *"]'), type: 'input' },
                { element: budgetSelect, label: document.getElementById('budget-label'), type: 'select' }
            ];

            let firstInvalidField = null;
            const lang = localStorage.getItem('selectedLanguage') || 'en';
            const messages = {
                en: 'Please fill out this field',
                it: 'Si prega di compilare questo campo'
            };

            // Check each required field
            requiredFields.forEach(field => {
                if (!field.element) return;

                let isValid = true;

                if (field.type === 'input') {
                    isValid = field.element.value.trim() !== '';
                } else if (field.type === 'select') {
                    isValid = field.element.value !== '';
                }

                // Check custom goal if selected
                if (field.element === budgetSelect && field.element.value === 'other') {
                    const customInput = document.getElementById('custom-goal-input');
                    if (!customInput || customInput.value.trim() === '') {
                        isValid = false;
                        field.element = customInput;
                        field.label = document.getElementById('budget-label');
                    }
                }

                if (!isValid) {
                    if (!firstInvalidField) {
                        firstInvalidField = field;
                    }

                    // Flash red animation
                    const targetElement = field.element;

                    if (targetElement) {
                        targetElement.style.border = '2px solid #F24535';
                        targetElement.style.animation = 'shake 0.3s';

                        setTimeout(() => {
                            targetElement.style.border = '';
                            targetElement.style.animation = '';
                        }, 1000);
                    }

                    // Show message near label
                    if (field.label && !field.label.querySelector('.validation-message')) {
                        const message = document.createElement('span');
                        message.className = 'validation-message';
                        message.textContent = ' - ' + messages[lang];
                        message.style.cssText = 'color: #F24535; font-size: 0.875rem; margin-left: 0.5rem;';
                        field.label.appendChild(message);

                        setTimeout(() => {
                            message.remove();
                        }, 3000);
                    }
                }
            });

            // Check social media validation
            const checkboxes = document.querySelectorAll('.social-checkbox');
            let hasValidSocial = false;
            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    const platform = checkbox.getAttribute('data-platform');
                    const usernameInput = document.querySelector(`input.platform-username[data-platform="${platform}"]`);
                    if (usernameInput && usernameInput.value.trim() !== '') {
                        hasValidSocial = true;
                    }
                }
            });

            if (!hasValidSocial) {
                const socialLabel = document.querySelector('label[data-en="Which social media platforms do you create content on?"]');
                if (socialLabel && !socialLabel.querySelector('.validation-message')) {
                    const message = document.createElement('span');
                    message.className = 'validation-message';
                    message.textContent = ' - ' + messages[lang];
                    message.style.cssText = 'color: #F24535; font-size: 0.875rem; margin-left: 0.5rem;';
                    socialLabel.appendChild(message);

                    setTimeout(() => {
                        message.remove();
                    }, 3000);
                }

                if (!firstInvalidField) {
                    firstInvalidField = { element: socialLabel, type: 'social' };
                }
            }

            // If any field is invalid, scroll to first one and stop
            if (firstInvalidField) {
                const scrollTarget = firstInvalidField.type === 'social' ? firstInvalidField.element :
                                   firstInvalidField.label || firstInvalidField.element;
                if (scrollTarget) {
                    scrollTarget.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return;
            }

            // All fields are valid, proceed with submission
            // Check if reCAPTCHA is available
            if (typeof grecaptcha !== 'undefined') {
                grecaptcha.ready(function() {
                    grecaptcha.execute('6LfyocYrAAAAAAO2wxWMTCTxNWrbS-qVSU_woJjU', {action: 'submit'}).then(function(token) {
                        document.getElementById('recaptchaResponse').value = token;
                        form.submit();
                    });
                });
            } else {
                form.submit();
            }
        });
    }

    // Update language field when language changes
    function updateLanguageField() {
        const savedLang = localStorage.getItem('selectedLanguage') || 'en';
        const languageInput = document.getElementById('selectedLanguageInput');
        if (languageInput) {
            languageInput.value = savedLang;
        }
    }

    updateLanguageField();

    const originalSetItem = localStorage.setItem;
    localStorage.setItem = function(key, value) {
        originalSetItem.call(this, key, value);
        if (key === 'selectedLanguage') {
            updateLanguageField();
        }
    };

})();
</script>
