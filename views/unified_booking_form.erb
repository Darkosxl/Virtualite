<style>
/* Booking form styles */
.booking-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    text-align: left;
}

.form-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-field.full-width {
    grid-column: 1 / -1;
}

.form-field label {
    color: white;
    font-weight: 600;
    font-size: clamp(0.9rem, 1vw, 1.1rem);
}

.form-field input, .form-field select {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    font-size: clamp(0.85rem, 0.95vw, 1rem);
    transition: all 0.3s;
}

.form-field input:focus, .form-field select:focus {
    outline: none;
    box-shadow: 0 0 0 2px #F24535;
    border-color: transparent;
}

.form-field input::placeholder {
    color: rgba(255, 255, 255, 0.7);
}

.form-field select {
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    padding-right: 2.5rem;
}

.form-field select option {
    background-color: #730202;
    color: white;
}

.form-field select option:disabled {
    color: #ff4444 !important;
    background-color: #330000 !important;
    text-decoration: line-through !important;
    font-weight: bold !important;
    cursor: not-allowed !important;
}

/* Custom checkbox styling */
.social-checkbox:checked + div .checkbox-dot {
    display: block !important;
}

.social-checkbox:checked + div {
    border-color: #F24535 !important;
    background-color: rgba(242, 69, 53, 0.1) !important;
}

.platform-username {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    font-size: clamp(0.85rem, 0.95vw, 1rem);
    transition: all 0.3s;
}

.platform-username:focus {
    outline: none;
    box-shadow: 0 0 0 2px #F24535;
    border-color: transparent;
}

.htmx-indicator {
    display: none !important;
}

.htmx-request .htmx-indicator {
    display: inline !important;
}

.htmx-request button {
    opacity: 0.7 !important;
    pointer-events: none !important;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
}

/* Button hover effects */
#submit-booking-btn:not(:disabled):hover {
    transform: scale(1.05);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}

#submit-booking-btn:not(:disabled) {
    opacity: 1 !important;
    cursor: pointer !important;
}

/* Responsive design */
@media (max-width: 768px) {
    .booking-form {
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .form-field.full-width {
        grid-column: 1;
    }
}
</style>

