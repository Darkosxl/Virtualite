<style>
/* Booking form styles - matching bento grid design */
.booking-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    text-align: left;
}

.form-field {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.form-field.full-width {
    grid-column: 1 / -1;
}

.form-field label {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 700;
    font-size: clamp(0.75rem, 0.9vw, 0.875rem);
    letter-spacing: 0.02em;
}

.form-field input, .form-field select {
    width: 100%;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: rgba(20, 20, 20, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    font-size: clamp(0.875rem, 0.95vw, 1rem);
    transition: all 0.15s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.form-field input:focus, .form-field select:focus {
    outline: none;
    background: rgba(20, 20, 20, 0.6);
    border-color: rgba(242, 69, 53, 0.5);
    box-shadow: 0 0 0 3px rgba(242, 69, 53, 0.15), 0 4px 12px rgba(242, 69, 53, 0.2);
}

.form-field input::placeholder {
    color: rgba(255, 255, 255, 0.45);
}

.form-field select {
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='rgba(255,255,255,0.7)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 1.25rem center;
    padding-right: 3rem;
}

.form-field select option {
    background-color: #1a1a1a;
    color: white;
}

.form-field select option:disabled {
    color: rgba(242, 69, 53, 0.5) !important;
    background-color: rgba(20, 20, 20, 0.9) !important;
    text-decoration: line-through !important;
    font-weight: bold !important;
    cursor: not-allowed !important;
}

/* Custom checkbox styling - matching bento design */
.social-checkbox:checked + div .checkbox-dot {
    display: block !important;
}

.social-checkbox:checked + div {
    border-color: rgba(242, 69, 53, 0.8) !important;
    background: linear-gradient(135deg, rgba(242, 82, 46, 0.2), rgba(242, 69, 53, 0.15)) !important;
    box-shadow: 0 2px 8px rgba(242, 69, 53, 0.2);
}

.platform-username {
    width: 100%;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: rgba(20, 20, 20, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    font-size: clamp(0.875rem, 0.95vw, 1rem);
    transition: all 0.15s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.platform-username:focus {
    outline: none;
    background: rgba(20, 20, 20, 0.6);
    border-color: rgba(242, 69, 53, 0.5);
    box-shadow: 0 0 0 3px rgba(242, 69, 53, 0.15), 0 4px 12px rgba(242, 69, 53, 0.2);
}

.htmx-indicator {
    display: none !important;
}

.htmx-request .htmx-indicator {
    display: inline !important;
}

.htmx-request button {
    opacity: 0.7 !important;
    pointer-events: none !important;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
}

/* Submit button - matching bento card style */
#submit-booking-btn {
    background: linear-gradient(135deg, #F2522E, #F24535) !important;
    border-radius: 1rem !important;
    padding: 1.25rem 2rem !important;
    font-weight: 700 !important;
    font-size: 1.125rem !important;
    box-shadow: 0 4px 12px rgba(242, 69, 53, 0.3), 0 8px 24px rgba(0, 0, 0, 0.15) !important;
    transition: all 0.3s ease !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
}

#submit-booking-btn:not(:disabled):hover {
    transform: translateY(-0.25rem) !important;
    box-shadow: 0 6px 16px rgba(242, 69, 53, 0.4), 0 12px 32px rgba(0, 0, 0, 0.2) !important;
}

#submit-booking-btn:not(:disabled):active {
    transform: translateY(0) !important;
}

#submit-booking-btn:not(:disabled) {
    opacity: 1 !important;
    cursor: pointer !important;
}

/* Social platforms grid - works on all devices */
.social-platforms-grid > div {
    display: flex;
    flex-direction: column;
}

/* Responsive design */
@media (max-width: 768px) {
    .booking-form {
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .form-field.full-width {
        grid-column: 1;
    }

    /* Mobile: Single column for social platforms */
    .social-platforms-grid {
        grid-template-columns: 1fr !important;
        gap: 1rem !important;
    }
}
</style>

