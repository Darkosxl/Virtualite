<div class="max-w-lg mx-auto bg-red-500 bg-opacity-20 backdrop-blur-lg rounded-3xl p-6 mt-6 border border-red-400 border-opacity-30">
    <div class="text-center">
        <div class="w-16 h-16 bg-red-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </div>
        <h3 class="text-white text-xl font-bold mb-3">Hata</h3>
        <p class="text-red-200 mb-4"><%= message %></p>
        <button onclick="location.reload()" 
                class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-xl font-semibold transition-colors">
            Tekrar Dene
        </button>
    </div>
</div>
